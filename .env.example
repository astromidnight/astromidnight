# Chave da API do Cal.com (Settings -> Developer/API Keys), só para consultar
# disponibilidade no momento do build. Nunca commitar a chave real -- copia
# este ficheiro para .env (já ignorado pelo git) e cola-a lá.
CAL_API_KEY=

# Projeto Supabase da loja (prints). A chave é a "publishable key" pública
# (protegida por RLS -- só lê itens com published = true), sem problema
# em expor no browser.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=

# Access keys do Web3Forms (web3forms.com) -- uma por formulário, cada uma
# do seu próprio form no dashboard do Web3Forms -- usadas para enviar o email
# diretamente do browser, sem servidor próprio. São supostas ser públicas -- o
# Web3Forms valida o pedido do lado deles, não há problema em expor no bundle.
PUBLIC_WEB3FORMS_HOST_KEY=
PUBLIC_WEB3FORMS_CONTACT_KEY=

# Google Analytics 4 -- só carrega depois de aceitares o aviso de cookies
# (ver CookieBanner.astro + Analytics.astro), nunca antes.
PUBLIC_GA_MEASUREMENT_ID=
