---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StargazingHero from '../components/StargazingHero.astro';
import StargazingDetails from '../components/StargazingDetails.astro';
import StargazingIncluded from '../components/StargazingIncluded.astro';
import StargazingLocation from '../components/StargazingLocation.astro';
import StargazingFaq from '../components/StargazingFaq.astro';
import StargazingCta from '../components/StargazingCta.astro';
import StargazingBookingModal from '../components/StargazingBookingModal.astro';
---

<Layout
  title="Observação Noturna — Astromidnight"
  description="Uma noite privada de observação no meu observatório no Alentejo. Até quatro adultos, telescópio de 250mm, guiada por um astrofotógrafo premiado pela NASA e pela ESA. 45€ por adulto."
>
  <Header />
  <main class="pb-20 pt-28 sm:pb-0 sm:pt-32">
    <StargazingHero />
    <StargazingDetails />
    <StargazingIncluded />
    <StargazingLocation />
    <StargazingFaq />
    <StargazingCta />
  </main>
  <Footer />
  <StargazingBookingModal />
</Layout>
