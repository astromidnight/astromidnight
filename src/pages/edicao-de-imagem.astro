---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EditingHero from '../components/EditingHero.astro';
import EditingWhoFor from '../components/EditingWhoFor.astro';
import EditingBeforeAfter from '../components/EditingBeforeAfter.astro';
import EditingTopics from '../components/EditingTopics.astro';
import EditingApproach from '../components/EditingApproach.astro';
import EditingHowItWorks from '../components/EditingHowItWorks.astro';
import EditingCta from '../components/EditingCta.astro';
---

<Layout
  title="Edição de imagem deep-sky — Astromidnight"
  description="Sessão individual de 2 horas, online, para editares os teus dados de céu profundo com confiança. Do fluxo base em PixInsight à edição não destrutiva em Photoshop, com um astrofotógrafo premiado pela NASA e pela ESA."
>
  <Header />
  <main class="pt-28 sm:pt-32">
    <EditingHero />
    <EditingWhoFor />
    <EditingBeforeAfter />
    <EditingTopics />
    <EditingApproach />
    <EditingHowItWorks />
    <EditingCta />
  </main>
  <Footer />
</Layout>
