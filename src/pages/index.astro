---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Calendar from '../components/Calendar.astro';
import HostSessions from '../components/HostSessions.astro';
import Pillar from '../components/Pillar.astro';
import Testimonials from '../components/Testimonials.astro';
import Shop from '../components/Shop.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import portraits from '../assets/Portraits.jpg';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <About />
    <Calendar />
    <HostSessions />
    <Pillar
      id="stargazing"
      eyebrow="Observação Noturna"
      title="Uma noite privada no observatório"
      description="Até quatro adultos (crianças não pagam), telescópio de 250mm, Saturno e nebulosas que a olho nu ninguém vê. Uma experiência guiada por um astrofotógrafo premiado, no céu escuro do Alentejo."
      price="45€"
      priceNote="por adulto · preço de lançamento"
      ctaLabel="Reservar noite"
      video={{ src: '/videos/observatory.mp4', poster: '/posters/observatory.jpg' }}
    />
    <Pillar
      id="retratos"
      eyebrow="Retratos sob as Estrelas"
      title="O teu retrato, com um mar de estrelas"
      description="Sessão dedicada de fotografia de retrato sob o céu estrelado. Não é um extra, é o serviço todo: sessão privada de 60 minutos, com 5 a 10 fotos finais editadas."
      price="160€"
      priceNote="por sessão · 1-2 pessoas"
      ctaLabel="Reservar sessão"
      flip
      image={{
        src: portraits,
        alt: 'Casal fotografado sob um céu cheio de estrelas',
      }}
    />
    <Pillar
      id="workshops"
      eyebrow="Workshops"
      title="Aprende, evolui, disfruta"
      description="Nightscape, Deepsky, troubleshooting do teu setup e mentoria de edição online. Formatos presenciais no observatório ou ao vivo, sempre em grupos pequenos."
      price="desde 40€"
      ctaLabel="Ver workshops"
      video={{ src: '/videos/workshops.mp4', poster: '/posters/workshops.jpg' }}
    />
    <Testimonials />
    <Shop />
    <Community />
  </main>
  <Footer />
</Layout>
