---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortraitsHero from '../components/PortraitsHero.astro';
import PortraitsDetails from '../components/PortraitsDetails.astro';
import PortraitsIncluded from '../components/PortraitsIncluded.astro';
import PortraitsHowItWorks from '../components/PortraitsHowItWorks.astro';
import PortraitsExamples from '../components/PortraitsExamples.astro';
import StargazingLocation from '../components/StargazingLocation.astro';
import PortraitsFaq from '../components/PortraitsFaq.astro';
import PortraitsCta from '../components/PortraitsCta.astro';
---

<Layout
  title="Retratos sob as Estrelas — Astromidnight"
  description="Sessão privada de fotografia de retrato sob o céu estrelado, no observatório do Astromidnight, no Alentejo. 60 minutos, 5 a 10 fotos finais editadas, 160€ por sessão até 2 pessoas."
>
  <Header />
  <main class="pb-20 pt-28 sm:pb-0 sm:pt-32">
    <PortraitsHero />
    <PortraitsDetails />
    <PortraitsIncluded />
    <PortraitsHowItWorks />
    <PortraitsExamples />
    <StargazingLocation />
    <PortraitsFaq />
    <PortraitsCta />
  </main>
  <Footer />
</Layout>
