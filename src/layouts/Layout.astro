---
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/700.css';
import '../styles/global.css';
import CalBookingModal from '../components/CalBookingModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title?: string;
  description?: string;
  // Imagem de partilha específica da página (ex.: a foto de um print na
  // loja) -- absoluta ou relativa a `site`. Sem isto, cai no thumb genérico.
  image?: string;
}

const {
  title = 'Astromidnight — O céu que já não vês',
  description =
    'Observações noturnas, retratos sob as estrelas e workshops de astrofotografia, no céu escuro do Alentejo, com o astrofotógrafo David Cruz.',
  image,
} = Astro.props;

// Astro.site vem do `site` em astro.config.mjs -- URLs sempre absolutos,
// para canonical/og:url/twitter:image funcionarem em qualquer plataforma
// que os consuma (Facebook, X, LinkedIn, WhatsApp preview, etc.).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image
  ? new URL(image, Astro.site)
  : new URL('/share_thumb.jpg', Astro.site);
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_PT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <StructuredData />
    <Analytics />
  </head>
  <body>
    <slot />
    <CalBookingModal />
    <CookieBanner />
    <script>
      // Revelação ao scroll
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealed = document.querySelectorAll('.reveal');
      if (reduced) {
        revealed.forEach((el) => el.classList.add('in-view'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealed.forEach((el) => io.observe(el));
      }

      // Vídeos abaixo da dobra: preload="none" + play só quando visíveis
      const lazyVideos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy]');
      const vio = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.2 }
      );
      lazyVideos.forEach((v) => vio.observe(v));
    </script>
  </body>
</html>
