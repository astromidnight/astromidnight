---
import { Image } from 'astro:assets';
import portrait from '../assets/ContactPortrait.jpg';
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);
---

<section class="relative pb-16 sm:pb-20">
  <BreadcrumbSchema label={t('nav.contacto')} />
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-sm text-cream-50/55">
      <a href={localizeHref('/', lang)} class="transition-colors hover:text-cream-50">{t('breadcrumb.inicio')}</a>
      <span class="mx-1.5">/</span>
      <span class="text-cream-50/80">{t('nav.contacto')}</span>
    </p>

    <div class="mt-10 grid items-center gap-12 lg:grid-cols-[6fr_5fr] lg:gap-20">
      <div>
        <p class="eyebrow reveal mb-4">{t('nav.contacto')}</p>
        <h1
          class="reveal max-w-2xl text-4xl font-bold leading-tight tracking-[-0.02em] sm:text-5xl lg:text-[3.25rem]"
          style="--reveal-delay: 0.05s"
        >
          {t('contact.title')}
        </h1>
        <p
          class="reveal mt-6 max-w-xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
          style="--reveal-delay: 0.1s"
        >
          {t('contact.desc')}
        </p>
      </div>

      <div class="reveal relative mx-auto w-full max-w-sm lg:max-w-none" style="--reveal-delay: 0.1s">
        <div
          class="absolute -inset-3 rounded-2xl border border-accent-400/25 bg-night-900 lg:-inset-4"
          aria-hidden="true"
        >
        </div>
        <Image
          src={portrait}
          alt={t('contact.portraitAlt')}
          class="relative aspect-[4/5] w-full rounded-xl object-cover"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 440px, 90vw"
          priority
        />
      </div>
    </div>
  </div>
</section>
