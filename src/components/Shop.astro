---
import { Image } from 'astro:assets';
import prints from '../data/prints.json';
import loja01 from '../assets/loja-01.jpg';
import loja02 from '../assets/loja-02.jpg';
import loja03 from '../assets/loja-03.jpg';

const images: Record<string, ImageMetadata> = {
  'loja-01': loja01,
  'loja-02': loja02,
  'loja-03': loja03,
};
import type { ImageMetadata } from 'astro';
---

<section id="loja" class="starfield relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">Loja</p>
    <div class="reveal flex flex-wrap items-end justify-between gap-6" style="--reveal-delay: 0.05s">
      <div>
        <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]">
          Leva uma para casa
        </h2>
        <p class="mt-4 max-w-lg text-cream-50/70">
          Prints em edição limitada e numerada, impressos sob encomenda.
        </p>
      </div>
      <a
        href="#loja"
        class="group inline-flex items-center gap-2 text-sm font-medium text-accent-200 transition-colors hover:text-accent-300"
      >
        Ver toda a loja
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        prints.map((print, i) => (
          <a
            href="#loja"
            class="reveal group block overflow-hidden rounded-2xl border border-cream-50/10 bg-night-900 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400/40"
            style={`--reveal-delay: ${0.1 + i * 0.07}s`}
          >
            <div class="overflow-hidden">
              <Image
                src={images[print.image]}
                alt={`Print «${print.title}» emoldurado em contexto de parede`}
                class="aspect-square w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 90vw"
              />
            </div>
            <div class="flex items-start justify-between gap-4 p-5">
              <div>
                <h3 class="font-bold transition-colors group-hover:text-accent-200">
                  {print.title}
                </h3>
                <p class="mt-1 text-sm text-cream-50/55">{print.object}</p>
                <p class="mt-3 text-xs uppercase tracking-[0.14em] text-cream-50/40">
                  Edição {print.sold}/{print.editionSize}
                </p>
              </div>
              <p class="shrink-0 text-right">
                <span class="block text-xs text-cream-50/50">desde</span>
                <span class="text-xl font-bold text-accent-200">
                  {print.priceFrom}
                </span>
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
