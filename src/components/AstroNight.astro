---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

// Como correm as até 4 horas. Rascunho meu, a rever pelo David.
const steps = [
  { title: t('astro.nightStep1Title'), desc: t('astro.nightStep1Desc') },
  { title: t('astro.nightStep2Title'), desc: t('astro.nightStep2Desc') },
  { title: t('astro.nightStep3Title'), desc: t('astro.nightStep3Desc') },
  { title: t('astro.nightStep4Title'), desc: t('astro.nightStep4Desc') },
];
---

<section class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">{t('astro.nightEyebrow')}</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          {t('astro.nightTitle')}
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-cream-50/75">
          {t('astro.nightDesc')}
        </p>
      </div>

      <ol class="reveal max-w-2xl" style="--reveal-delay: 0.05s">
        {
          steps.map((s, i) => (
            <li class="flex gap-5 border-b border-cream-50/10 py-5 last:border-none">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent-400/35 text-sm font-medium text-accent-200">
                {i + 1}
              </span>
              <div>
                <p class="font-medium text-cream-50">{s.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream-50/60">{s.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
