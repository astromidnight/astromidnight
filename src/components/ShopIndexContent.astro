---
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { getPublishedPrints, formatPrice, printSubtitle } from '../lib/prints';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const prints = await getPublishedPrints();
---

<BreadcrumbSchema label={t('nav.loja')} />
<main class="pt-32 pb-24 sm:pt-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-sm text-cream-50/55">
      <a href={localizeHref('/', lang)} class="transition-colors hover:text-cream-50">{t('breadcrumb.inicio')}</a>
      <span class="mx-1.5">/</span>
      <span class="text-cream-50/80">{t('nav.loja')}</span>
    </p>
    <p class="eyebrow reveal mb-4 mt-10">{t('nav.loja')}</p>
    <h1 class="reveal text-4xl font-bold tracking-[-0.02em] sm:text-5xl">{t('shop.title')}</h1>
    <p class="reveal mt-4 max-w-lg text-cream-50/70" style="--reveal-delay: 0.05s">
      {t('shop.desc')}
    </p>

    {
      prints.length === 0 ? (
        <p class="mt-16 text-cream-50/60">{t('shop.empty')}</p>
      ) : (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {prints.map((print, i) => (
            <a
              href={localizeHref(`/loja/${print.slug}`, lang)}
              class="reveal group block overflow-hidden rounded-2xl border border-cream-50/10 bg-night-900 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400/40"
              style={`--reveal-delay: ${0.05 + (i % 6) * 0.06}s`}
            >
              <div class="overflow-hidden">
                <img
                  src={print.thumb_url}
                  alt={`Print «${print.title}» ${t('shop.printAltSuffix')}`}
                  loading="lazy"
                  class="aspect-square w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                />
              </div>
              <div class="flex items-start justify-between gap-4 p-5">
                <div>
                  <h2 class="font-bold transition-colors group-hover:text-accent-200">
                    {print.title}
                  </h2>
                  <p class="mt-1 text-sm text-cream-50/55">{printSubtitle(print)}</p>
                </div>
                {print.price_cents != null && (
                  <p class="shrink-0 text-right">
                    <span class="text-xl font-bold text-accent-200">
                      {formatPrice(print.price_cents, print.currency)}
                    </span>
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</main>
