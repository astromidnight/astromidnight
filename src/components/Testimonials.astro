---
import { useTranslations } from '../i18n/utils';
import { getPlaceReviews } from '../lib/reviews';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const data = await getPlaceReviews(lang);
const reviews = data?.reviews ?? [];

const starSvg = (filled: boolean) =>
  filled
    ? '<svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z"/></svg>'
    : '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" class="h-4 w-4 text-cream-50/25"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z"/></svg>';

const starsHtml = (rating: number) =>
  Array.from({ length: 5 }, (_, i) => starSvg(i < Math.round(rating))).join('');

const WRITE_REVIEW_FALLBACK = 'https://search.google.com/local/writereview?placeid=ChIJsTSYGOLBGQ0RVFFE5LTN1bI';
---

<section class="relative border-y border-cream-50/8 bg-night-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">{t('testimonials.eyebrow')}</p>
        <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]">
          {t('testimonials.title')}
        </h2>
      </div>

      {
        data && data.totalReviews > 0 && (
          <div class="flex items-center gap-2 text-cream-50/70">
            <span class="flex gap-0.5 text-accent-300" set:html={starsHtml(data.rating)} />
            <span class="text-sm">
              {data.rating.toFixed(1)} {t('testimonials.ratingSuffix')} ·{' '}
              {data.totalReviews}{' '}
              {data.totalReviews === 1 ? t('testimonials.reviewWord') : t('testimonials.reviewWordPlural')}
            </span>
          </div>
        )
      }
    </div>

    {
      reviews.length > 0 ? (
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <figure
              class="reveal flex flex-col rounded-2xl border border-cream-50/10 bg-night-800 p-7"
              style={`--reveal-delay: ${0.1 + i * 0.07}s`}
            >
              <span class="flex gap-0.5 text-accent-300" set:html={starsHtml(r.rating)} />
              <blockquote class="mt-4 leading-relaxed text-cream-50/75">{r.text}</blockquote>
              <figcaption class="mt-6 flex items-center gap-3 pt-6">
                {r.authorPhotoUrl && (
                  <img
                    src={r.authorPhotoUrl}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                    class="h-9 w-9 shrink-0 rounded-full"
                  />
                )}
                <span>
                  <span class="block text-sm font-medium text-cream-50">{r.authorName}</span>
                  <span class="block text-xs text-cream-50/45">{r.relativeTime}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="reveal mt-10 max-w-md text-cream-50/60">{t('testimonials.emptyState')}</p>
      )
    }

    <div class="reveal mt-10 flex flex-wrap gap-4" style="--reveal-delay: 0.3s">
      <a href={data?.writeReviewUrl ?? WRITE_REVIEW_FALLBACK} target="_blank" rel="noopener" class="btn btn-primary">
        {t('testimonials.writeReview')}
      </a>
      {data?.mapsUrl && (
        <a href={data.mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost">
          {t('testimonials.seeAllReviews')}
        </a>
      )}
    </div>
  </div>
</section>
