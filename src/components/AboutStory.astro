---
// Percurso pessoal, adaptado do texto de astromidnight.pt/about para
// português de Portugal.
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const paragraphs = [
  t('about.story1'),
  t('about.story2'),
  t('about.story3'),
];
---

<section class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <p class="eyebrow reveal">{t('about.storyEyebrow')}</p>
      <div class="reveal max-w-2xl space-y-6" style="--reveal-delay: 0.05s">
        {
          paragraphs.map((text) => (
            <p class="text-base leading-relaxed text-cream-50/75 sm:text-lg">{text}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
