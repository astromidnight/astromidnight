---
import { Image } from 'astro:assets';
import heroImage from '../assets/StargazingHero.jpg';
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);
const shareText = t('share.textStargazing');
const linkCopiedText = t('share.linkCopied');
---

<section class="relative">
  <BreadcrumbSchema label={t('nav.observacao')} />
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal flex items-center justify-between gap-4">
      <p class="text-sm text-cream-50/55">
        <a href={localizeHref('/#stargazing', lang)} class="transition-colors hover:text-cream-50">{t('breadcrumb.inicio')}</a>
        <span class="mx-1.5">/</span>
        <span class="text-cream-50/80">{t('nav.observacao')}</span>
      </p>
      <button
        type="button"
        id="share-button"
        class="inline-flex items-center gap-1.5 rounded-full border border-cream-50/25 px-4 py-2 text-xs font-medium text-cream-50/75 transition-colors hover:border-accent-200 hover:text-accent-200"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 11L17 6M7 13l10 5M8 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm14-6a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm0 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
        </svg>
        <span id="share-label">{t('share.label')}</span>
      </button>
    </div>

    <p class="eyebrow reveal mb-4 mt-8" style="--reveal-delay: 0.05s">{t('nav.observacao')}</p>
    <h1
      class="reveal max-w-3xl text-4xl font-bold leading-tight tracking-[-0.02em] sm:text-5xl lg:text-[3.25rem]"
      style="--reveal-delay: 0.1s"
    >
      {t('stargazing.title')}
    </h1>
    <p
      class="reveal mt-6 max-w-2xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
      style="--reveal-delay: 0.15s"
    >
      {t('stargazing.heroDesc')}
    </p>
  </div>

  <div class="reveal mt-10" style="--reveal-delay: 0.2s">
    <Image
      src={heroImage}
      alt={t('stargazing.heroImgAlt')}
      class="aspect-[21/9] w-full object-cover"
      widths={[768, 1152, 1536, 1920]}
      sizes="100vw"
      priority
    />
  </div>
</section>

<script define:vars={{ shareText, linkCopiedText }}>
  const btn = document.getElementById('share-button');
  const label = document.getElementById('share-label');

  btn.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          text: shareText,
          url: window.location.href,
        });
      } catch {
        // Utilizador cancelou a partilha nativa — não faz nada.
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(window.location.href);
      const original = label.textContent;
      label.textContent = linkCopiedText;
      setTimeout(() => {
        label.textContent = original;
      }, 2000);
    } catch {
      // Sem Web Share API nem Clipboard API: não faz nada, o link já está na barra do browser.
    }
  });
</script>
