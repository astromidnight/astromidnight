---
import { getWhatsappUrl } from '../lib/contact';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'pt') as 'pt' | 'en';
const t = useTranslations(lang);
const whatsappUrl = getWhatsappUrl(lang);
const subscribingLabel = t('community.subscrevendo');
const subscribeLabel = t('community.subscrever');
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-24 sm:py-28">
  <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-2 lg:gap-24">
    <div class="reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">
        {t('community.title1')}
      </h2>
      <p class="mt-3 max-w-md text-cream-50/70">
        {t('community.desc1')}
      </p>
      <form id="newsletter-form" class="mt-7 flex max-w-md flex-col gap-3 sm:flex-row">
        <input type="text" name="website" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="newsletter-email">{t('community.emailLabel')}</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder={t('community.emailPlaceholder')}
          autocomplete="email"
          class="min-h-12 flex-1 rounded-full border border-cream-50/20 bg-night-950/60 px-5 text-cream-50 placeholder:text-cream-50/35 focus:border-accent-300"
        />
        <button type="submit" id="newsletter-submit" class="btn btn-primary shrink-0">{t('community.subscrever')}</button>
      </form>
      <p
        id="newsletter-note"
        class="mt-3 hidden text-sm text-accent-200"
        role="status"
      >
        {t('community.newsletterNote')}
      </p>
      <p
        id="newsletter-error"
        class="mt-3 hidden text-sm text-red-300"
        role="status"
      >
        {t('community.newsletterError')}
      </p>
    </div>

    <div class="reveal" style="--reveal-delay: 0.1s">
      <h2 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">
        {t('community.whatsappTitle')}
      </h2>
      <p class="mt-3 max-w-md text-cream-50/70">
        {t('community.whatsappDesc')}
      </p>
      <a
        href={whatsappUrl ?? localizeHref('/contacto', lang)}
        target={whatsappUrl ? '_blank' : undefined}
        rel={whatsappUrl ? 'noopener' : undefined}
        class="btn btn-ghost mt-7"
      >
        <svg
          class="h-4.5 w-4.5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.1-.7l.4-.5c.1-.2.2-.3.3-.5v-.5c0-.1-.5-1.4-.7-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"
          ></path>
        </svg>
        {t('whatsapp.abrir')}
      </a>
    </div>
  </div>
</section>

<script define:vars={{ subscribingLabel, subscribeLabel }}>
  const form = document.getElementById('newsletter-form');
  const submitBtn = document.getElementById('newsletter-submit');
  const note = document.getElementById('newsletter-note');
  const errorNote = document.getElementById('newsletter-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    note.classList.add('hidden');
    errorNote.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = subscribingLabel;

    try {
      const data = new FormData(form);
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: data.get('email'),
          website: data.get('website'),
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      note.classList.remove('hidden');
      form.reset();
    } catch (err) {
      console.warn('[newsletter-form] falha ao subscrever:', err);
      errorNote.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = subscribeLabel;
    }
  });
</script>
