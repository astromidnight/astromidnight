---
import { CAL_LINKS, calLinkPath } from '../lib/calcom';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const retratosLink = calLinkPath(CAL_LINKS.retratos);

const stats = [
  { value: '160€', label: t('home.retratos.priceNote') },
  { value: '60min', label: t('stargazing.stat2Label') },
  { value: '7–10', label: t('retratos.statPhotosLabel') },
  { value: t('retratos.statPrivateValue'), label: t('retratos.statPrivateLabel') },
];
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">{t('retratos.detailsEyebrow')}</p>
    <p class="reveal max-w-2xl text-base leading-relaxed text-cream-50/75 sm:text-lg" style="--reveal-delay: 0.05s">
      {t('retratos.detailsDesc')}
    </p>

    <dl class="reveal mt-10 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4" style="--reveal-delay: 0.1s">
      {
        stats.map((s) => (
          <div class="border-l border-accent-400/30 pl-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-3xl font-bold tracking-tight text-accent-200 sm:text-4xl">{s.value}</dd>
            <dd class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-cream-50/55">
              {s.label}
            </dd>
          </div>
        ))
      }
    </dl>

    <button
      type="button"
      data-book-link={retratosLink}
      class="btn btn-primary reveal mt-10"
      style="--reveal-delay: 0.15s"
    >
      {t('hero.ctaReservar')}
    </button>
  </div>
</section>
