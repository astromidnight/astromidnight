---
import { Image } from 'astro:assets';
import logo from '../assets/Logo.png';

const nav = [
  { label: 'Stargazing', href: '#stargazing' },
  { label: 'Retratos', href: '#retratos' },
  { label: 'Workshops', href: '#workshops' },
  { label: 'Loja', href: '#loja' },
  { label: 'Galeria', href: '#galeria' },
  { label: 'Sobre', href: '#sobre' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8"
  >
    <a href="#top" class="shrink-0" aria-label="Astromidnight — início">
      <Image src={logo} alt="Astromidnight" class="h-9 w-auto sm:h-10" densities={[1, 2]} />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="group relative text-sm font-normal text-cream-50/75 transition-colors hover:text-cream-50"
          >
            {item.label}
            <span class="absolute -bottom-1 left-0 h-px w-0 bg-accent-300 transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="#calendario" class="btn btn-primary hidden !min-h-0 !py-2.5 sm:inline-flex">
        Reservar
      </a>
      <button
        id="menu-toggle"
        class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-cream-50/20 text-cream-50 lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path class="menu-open-icon" d="M4 7h16M4 12h16M4 17h16" />
          <path class="menu-close-icon hidden" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-cream-50/10 bg-night-950/95 backdrop-blur-xl lg:hidden"
  >
    <nav class="flex flex-col px-5 py-4" aria-label="Navegação móvel">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-cream-50/5 py-3.5 text-base text-cream-50/85 last:border-none hover:text-accent-200"
          >
            {item.label}
          </a>
        ))
      }
      <a href="#calendario" class="btn btn-primary mt-4">Reservar</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const solidClasses = ['bg-night-950/85', 'backdrop-blur-xl', 'border-b', 'border-cream-50/10'];
  const onScroll = () => {
    if (window.scrollY > 32) header.classList.add(...solidClasses);
    else header.classList.remove(...solidClasses);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.menu-open-icon')!.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close-icon')!.classList.toggle('hidden', !open);
    if (open) header.classList.add(...solidClasses);
    else onScroll();
  };
  toggle.addEventListener('click', () =>
    setOpen(menu.classList.contains('hidden'))
  );
  menu.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );
</script>
