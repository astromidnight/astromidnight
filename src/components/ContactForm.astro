---
// Envia por Web3Forms (web3forms.com) direto do browser, mesmo padrão do
// formulário de alojamentos rurais (HostSessions.astro) -- chave própria
// deste form, ver PUBLIC_WEB3FORMS_CONTACT_KEY no .env.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_CONTACT_KEY;

const subjects = [
  'Reservar uma sessão',
  'Alojamentos rurais',
  'Workshops e mentoria',
  'Prints e loja',
  'Imprensa',
  'Outro assunto',
];

const field =
  'min-h-12 w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300';
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">Formulário</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          Preferes escrever?
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-cream-50/75">
          Se ainda tens dúvidas escolhe um tema e envia uma mensagem.
        </p>
      </div>

      <form id="contact-form" class="reveal max-w-xl" style="--reveal-delay: 0.05s">
        <input type="hidden" name="subject" value="Novo contacto — Astromidnight" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />

        <div class="flex flex-col gap-3">
          <label class="sr-only" for="contact-subject">Assunto</label>
          <div class="relative">
            <select id="contact-subject" name="assunto" required class:list={[field, 'appearance-none pr-11']}>
              {subjects.map((s) => <option value={s}>{s}</option>)}
            </select>
            <svg
              class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-cream-50/50"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            ><path d="M6 9l6 6 6-6" /></svg>
          </div>

          <label class="sr-only" for="contact-name">O teu nome</label>
          <input
            id="contact-name"
            name="nome"
            type="text"
            required
            placeholder="o teu nome"
            autocomplete="name"
            class={field}
          />

          <label class="sr-only" for="contact-email">O teu email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="o teu email"
            autocomplete="email"
            class={field}
          />

          <label class="sr-only" for="contact-message">Mensagem</label>
          <textarea
            id="contact-message"
            name="mensagem"
            rows="5"
            required
            placeholder="a tua mensagem"
            class="w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 py-3 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300"
          ></textarea>

          <button type="submit" id="contact-submit" class="btn btn-primary mt-1 w-full sm:w-fit sm:px-10">
            Enviar mensagem
          </button>
        </div>

        <p id="contact-note" class="mt-4 hidden text-sm text-accent-200" role="status">
          Recebido, respondo assim que puder.
        </p>
        <p id="contact-error" class="mt-4 hidden text-sm text-red-300" role="status">
          Não foi possível enviar. Tenta de novo ou escreve para o email de contacto.
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ web3formsKey }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-submit');
  const note = document.getElementById('contact-note');
  const errorNote = document.getElementById('contact-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    note.classList.add('hidden');
    errorNote.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'A enviar…';

    try {
      const data = new FormData(form);
      data.append('access_key', web3formsKey);

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);

      note.classList.remove('hidden');
      form.reset();
    } catch (err) {
      console.warn('[contact-form] falha ao enviar via Web3Forms:', err);
      errorNote.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar mensagem';
    }
  });
</script>
