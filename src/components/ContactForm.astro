---
// Formato "maquete", igual ao formulário dos alojamentos (HostSessions.astro)
// e ao da newsletter: mostra uma nota ao submeter e ainda não liga a backend.
// Por decidir se vai por Supabase (já é dependência do projeto, para a loja)
// ou por um serviço de formulários.
const subjects = [
  'Reservar uma sessão',
  'Alojamentos rurais',
  'Workshops e mentoria',
  'Prints e loja',
  'Imprensa',
  'Outro assunto',
];

const field =
  'min-h-12 w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300';
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">Formulário</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          Preferes escrever?
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-cream-50/75">
          Diz-me do que precisas e eu respondo. Se for sobre uma noite específica, indica
          a data que tens em mente.
        </p>
      </div>

      <form id="contact-form" class="reveal max-w-xl" style="--reveal-delay: 0.05s">
        <div class="flex flex-col gap-3">
          <label class="sr-only" for="contact-subject">Assunto</label>
          <select id="contact-subject" name="assunto" required class:list={[field, 'appearance-none']}>
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>

          <label class="sr-only" for="contact-name">O teu nome</label>
          <input
            id="contact-name"
            name="nome"
            type="text"
            required
            placeholder="o teu nome"
            autocomplete="name"
            class={field}
          />

          <label class="sr-only" for="contact-email">O teu email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="o teu email"
            autocomplete="email"
            class={field}
          />

          <label class="sr-only" for="contact-message">Mensagem</label>
          <textarea
            id="contact-message"
            name="mensagem"
            rows="5"
            required
            placeholder="a tua mensagem"
            class="w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 py-3 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300"
          ></textarea>

          <button type="submit" class="btn btn-primary mt-1 w-full sm:w-fit sm:px-10">
            Enviar mensagem
          </button>
        </div>

        <p id="contact-note" class="mt-4 hidden text-sm text-accent-200" role="status">
          Recebido, respondo assim que puder. (Maquete: ainda não está ligado a nenhum
          serviço.)
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('contact-note')!.classList.remove('hidden');
    form.reset();
  });
</script>
