---
// Os cinco pontos de "How does it work?" do site atual, adaptados ao facto
// de agora existir uma sessão única em vez de uma lista de cursos.
const steps = [
  {
    title: 'Reservas a sessão',
    desc: 'Escolhes no calendário e pagas na reserva. São sempre 2 horas, seja qual for o tema.',
  },
  {
    title: 'Combinamos o horário',
    desc: 'Depois da reserva entro em contacto contigo para acertarmos a hora que te dá jeito.',
  },
  {
    title: 'Dizes-me o que precisas',
    desc: 'Antes da sessão contas-me onde estás e o que queres resolver, para eu preparar tudo.',
  },
  {
    title: 'Trabalhamos com os teus dados',
    desc: 'Usamos as tuas imagens. Se ainda não tens nada com que trabalhar, forneço eu os dados.',
  },
  {
    title: 'Acompanho do início ao fim',
    desc: 'A sessão é online, por videochamada, e guio-te durante todo o tempo por partilha de ecrã.',
  },
];
---

<section class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">Como funciona</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          Da reserva à imagem final
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-cream-50/75">
          Precisas de ter o PixInsight instalado, e o Photoshop para os temas avançados.
          Os scripts da RC-Astro ajudam mas são opcionais na maioria dos casos.
        </p>
      </div>

      <ol class="reveal max-w-2xl" style="--reveal-delay: 0.05s">
        {
          steps.map((s, i) => (
            <li class="flex gap-5 border-b border-cream-50/10 py-5 last:border-none">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent-400/35 text-sm font-medium text-accent-200">
                {i + 1}
              </span>
              <div>
                <p class="font-medium text-cream-50">{s.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream-50/60">{s.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
