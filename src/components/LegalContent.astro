---
// Wrapper de conteúdo para páginas legais (Termos, Privacidade) -- breadcrumb,
// título e data de atualização, com o texto em prosa a passar por slot.
import BreadcrumbSchema from './BreadcrumbSchema.astro';

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<BreadcrumbSchema label={title} />
<div class="mx-auto max-w-3xl px-5 sm:px-8">
  <p class="reveal text-sm text-cream-50/55">
    <a href="/" class="transition-colors hover:text-cream-50">Início</a>
    <span class="mx-1.5">/</span>
    <span class="text-cream-50/80">{title}</span>
  </p>

  <h1 class="reveal mt-10 text-4xl font-bold tracking-[-0.02em] sm:text-5xl">
    {title}
  </h1>
  <p class="reveal mt-3 text-sm text-cream-50/50" style="--reveal-delay: 0.05s">
    Última atualização: {updated}
  </p>

  <div
    class="reveal legal-prose mt-10 max-w-none text-cream-50/75"
    style="--reveal-delay: 0.1s"
  >
    <slot />
  </div>
</div>

<style>
  .legal-prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-cream-50);
    letter-spacing: -0.01em;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(p) {
    margin-top: 0.9rem;
    line-height: 1.7;
  }
  .legal-prose :global(ul) {
    margin-top: 0.9rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal-prose :global(li) {
    margin-top: 0.4rem;
    line-height: 1.7;
  }
  .legal-prose :global(a) {
    color: var(--color-accent-200);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(strong) {
    color: var(--color-cream-50);
    font-weight: 600;
  }
</style>
