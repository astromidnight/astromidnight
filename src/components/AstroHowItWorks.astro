---
import { LOCATION, MAPS_URL } from '../lib/contact';

// A política de mau tempo é a mesma da observação noturna, confirmada pelo
// David: remarcação ou reembolso total.
const steps = [
  {
    title: 'Reservas a sessão',
    desc: 'Escolhes no calendário e pagas na reserva. São até 4 horas, sigas o caminho que seguires.',
  },
  {
    title: 'Combinamos a noite',
    desc: 'Depois da reserva falo contigo para acertarmos a data e qual dos dois caminhos queres seguir.',
  },
  {
    title: 'Vens ao observatório',
    desc: `A sessão é presencial, em ${LOCATION}. Como é um espaço privado, a morada exata segue no email de confirmação.`,
  },
  {
    title: 'Se o tempo não ajudar',
    desc: 'Remarcamos para outra noite ou devolvo o valor por inteiro. Nunca perdes o que pagaste por causa das nuvens.',
  },
];
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">Como funciona</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          Da reserva à noite no observatório
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-cream-50/75">
          Traz roupa quente e calçado fechado. Mesmo no verão, as noites no Alentejo
          arrefecem bastante depois do pôr do sol.
        </p>
        <a href={MAPS_URL} target="_blank" rel="noopener" class="btn btn-ghost mt-8">
          Ver no mapa
        </a>
      </div>

      <ol class="reveal max-w-2xl" style="--reveal-delay: 0.05s">
        {
          steps.map((s, i) => (
            <li class="flex gap-5 border-b border-cream-50/10 py-5 last:border-none">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent-400/35 text-sm font-medium text-accent-200">
                {i + 1}
              </span>
              <div>
                <p class="font-medium text-cream-50">{s.title}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream-50/60">{s.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
