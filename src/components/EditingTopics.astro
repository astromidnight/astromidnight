---
// Os seis cursos separados do site atual (astromidnight.pt/courses) passam
// aqui a temas possíveis para a MESMA sessão de 2h, em vez de produtos
// distintos. As agendas e requisitos são os que já lá estavam, traduzidos.
// Nomes de processos e scripts ficam em inglês, que é como aparecem no
// PixInsight e no Photoshop.
type Topic = {
  code: string;
  title: string;
  desc: string;
  agenda: string[];
  needs: string[];
};

const foundations: Topic[] = [
  {
    code: '1.1',
    title: 'Fluxo cor ou mono',
    desc: 'As bases do processamento de imagem one-shot color ou mono em PixInsight.',
    agenda: [
      'Análise do stack',
      'Visão geral do fluxo de trabalho',
      'Corte da imagem',
      'Image solver',
      'Correção de estrelas',
      'Remoção de gradientes',
      'Calibração de cor',
      'Redução e sharpening de estrelas',
      'Redução de ruído',
      'Separar as estrelas',
      'Stretch da imagem starless',
      'Stretch das estrelas',
      'Máscaras de intervalo',
      'Juntar estrelas e starless',
      'Curvas',
    ],
    needs: ['Stacks a cor ou mono', 'PixInsight', 'Scripts RC-Astro (opcional)'],
  },
  {
    code: '1.2',
    title: 'Fluxo dualband ou narrowband',
    desc: 'As bases do processamento de imagem dualband ou narrowband em PixInsight.',
    agenda: [
      'Análise do stack',
      'Visão geral do fluxo de trabalho',
      'Corte da imagem',
      'Image solver',
      'Correção de estrelas',
      'Remoção de gradientes',
      'Calibração de cor (HOO)',
      'Redução e sharpening de estrelas',
      'Redução de ruído',
      'Separar as estrelas',
      'Stretch da imagem starless',
      'Stretch das estrelas',
      'Máscaras de intervalo',
      'Juntar estrelas e starless',
      'Curvas',
    ],
    needs: ['Stacks dualband ou narrowband', 'PixInsight', 'Scripts RC-Astro (opcional)'],
  },
  {
    code: '1.3',
    title: 'Crítica e edição da tua imagem',
    desc: 'Para quem está preso numa imagem específica e quer conselhos e orientação a dois.',
    agenda: [
      'Análise do stack',
      'Revisão do teu fluxo de trabalho',
      'Crítica da imagem',
      'Edição a dois',
      'Conselhos para chegares a melhores resultados',
    ],
    needs: [
      'Stacks a cor, dualband, mono ou narrowband',
      'PixInsight',
      'Scripts RC-Astro (opcional)',
    ],
  },
];

const advanced: Topic[] = [
  {
    code: '2.1',
    title: 'Edição não destrutiva avançada',
    desc: 'Levar a imagem mais além com técnicas de edição não destrutiva em Photoshop.',
    agenda: [
      'Perceber camadas e camadas de ajuste',
      'Construir a imagem com canais em camadas',
      'Camadas de ajuste para afinar a intensidade',
      'Curvas e máscaras',
      'Camera Raw',
      'Exportação',
    ],
    needs: [
      'Imagem starless não linear (RGB, dualband ou narrowband)',
      'Imagem de estrelas não linear (RGB, dualband ou narrowband)',
      'Photoshop',
    ],
  },
  {
    code: '2.2',
    title: 'Star stretch avançado, com spikes de difração',
    desc: 'Os Newtonianos são famosos pelos spikes de difração. Como esticar as estrelas para os pôr bonitos.',
    agenda: [
      'Porque é que as estrelas importam',
      'Separar as estrelas',
      'Stretch da imagem starless com GHS',
      'Star stretch (HT) versus star stretch avançado (GHS)',
      'Juntar as estrelas ao starless, em Photoshop',
      'Fazer brilhar os spikes com curvas, em Photoshop',
    ],
    needs: [
      'Stack OSC ou mono RGB com spikes de difração',
      'PixInsight',
      'Scripts RC-Astro',
      'Photoshop',
    ],
  },
  {
    code: '2.3',
    title: 'Subtração de contínuo',
    desc: 'Misturar dados narrowband nos teus dados broadband, com subtração de contínuo em Photoshop.',
    agenda: [
      'Perceber o conceito de subtração de contínuo',
      'Juntar Ha ao RGB com subtração de contínuo',
      'Camadas de ajuste para afinar e chegar ao melhor resultado',
      'Curvas',
    ],
    needs: [
      'Imagem RGB starless não linear',
      'Imagem RGB de estrelas não linear',
      'Imagem Ha starless não linear',
      'Photoshop',
    ],
  },
];

const groups = [
  {
    label: 'Fundações',
    intro: 'Para editares com confiança e consistência, do princípio ao fim.',
    topics: foundations,
  },
  {
    label: 'Avançado',
    intro: 'Para quem já tem bases sólidas e quer dar um passo em frente.',
    topics: advanced,
  },
];
---

<section id="temas" class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">O que vemos</p>
    <h2
      class="reveal max-w-2xl text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl"
      style="--reveal-delay: 0.05s"
    >
      A sessão é feita à tua medida
    </h2>
    <p
      class="reveal mt-6 max-w-2xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
      style="--reveal-delay: 0.1s"
    >
      Não tens de escolher um curso de uma lista. Depois de reservares, dizes-me onde
      estás e o que queres resolver, e eu preparo a sessão a partir daí. Estes são os
      temas que podemos cobrir, sozinhos ou combinados.
    </p>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {
        groups.map((g, gi) => (
          <div class="reveal" style={`--reveal-delay: ${0.15 + gi * 0.05}s`}>
            <div class="flex items-baseline gap-3">
              <h3 class="text-xl font-bold">{g.label}</h3>
              <span class="h-px flex-1 bg-cream-50/12" aria-hidden="true" />
            </div>
            <p class="mt-2 text-sm text-cream-50/60">{g.intro}</p>

            <div class="mt-6 divide-y divide-cream-50/12 border-t border-cream-50/12">
              {g.topics.map((t) => (
                <details class="group py-2 [&::-webkit-details-marker]:hidden">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-4">
                    <span>
                      <span class="flex items-baseline gap-2.5">
                        <span class="text-xs font-medium text-accent-200">{t.code}</span>
                        <span class="font-medium text-cream-50">{t.title}</span>
                      </span>
                      <span class="mt-1 block text-sm leading-relaxed text-cream-50/55">
                        {t.desc}
                      </span>
                    </span>
                    <span class="shrink-0 pt-0.5 text-xl leading-none text-cream-50/60 transition-transform duration-200 group-open:rotate-45">
                      +
                    </span>
                  </summary>

                  <div class="grid gap-6 pb-5 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/40">
                        Alinhamento
                      </p>
                      <ul class="mt-3 space-y-1.5">
                        {t.agenda.map((a) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-cream-50/70">
                            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-300/70" aria-hidden="true" />
                            {a}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/40">
                        Precisas de
                      </p>
                      <ul class="mt-3 space-y-1.5">
                        {t.needs.map((n) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-cream-50/70">
                            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cream-50/30" aria-hidden="true" />
                            {n}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
