---
import { useTranslations } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'pt') as 'pt' | 'en';
const t = useTranslations(lang);

// Os seis cursos separados do site atual (astromidnight.pt/courses) passam
// aqui a temas possíveis para a MESMA sessão de 2h, em vez de produtos
// distintos. As agendas e requisitos são os que já lá estavam, traduzidos.
// Nomes de processos e scripts ficam em inglês, que é como aparecem no
// PixInsight e no Photoshop. Conteúdo bilingue inline (não no i18n/ui.ts):
// técnico e só usado aqui.
type Bi = { pt: string; en: string };
type Topic = {
  code: string;
  title: Bi;
  desc: Bi;
  agenda: Bi[];
  needs: Bi[];
};

const foundations: Topic[] = [
  {
    code: '1.1',
    title: { pt: 'Fluxo cor ou mono', en: 'Color or mono workflow' },
    desc: {
      pt: 'As bases do processamento de imagem one-shot color ou mono em PixInsight.',
      en: 'The basics of one-shot color or mono image processing in PixInsight.',
    },
    agenda: [
      { pt: 'Análise do stack', en: 'Stack analysis' },
      { pt: 'Visão geral do fluxo de trabalho', en: 'Workflow overview' },
      { pt: 'Corte da imagem', en: 'Cropping the image' },
      { pt: 'Image solver', en: 'Image solver' },
      { pt: 'Correção de estrelas', en: 'Star correction' },
      { pt: 'Remoção de gradientes', en: 'Gradient removal' },
      { pt: 'Calibração de cor', en: 'Color calibration' },
      { pt: 'Redução e sharpening de estrelas', en: 'Star reduction and sharpening' },
      { pt: 'Redução de ruído', en: 'Noise reduction' },
      { pt: 'Separar as estrelas', en: 'Separating the stars' },
      { pt: 'Stretch da imagem starless', en: 'Stretching the starless image' },
      { pt: 'Stretch das estrelas', en: 'Stretching the stars' },
      { pt: 'Máscaras de intervalo', en: 'Range masks' },
      { pt: 'Juntar estrelas e starless', en: 'Combining stars and starless' },
      { pt: 'Curvas', en: 'Curves' },
    ],
    needs: [
      { pt: 'Stacks a cor ou mono', en: 'Color or mono stacks' },
      { pt: 'PixInsight', en: 'PixInsight' },
      { pt: 'Scripts RC-Astro (opcional)', en: 'RC-Astro scripts (optional)' },
    ],
  },
  {
    code: '1.2',
    title: { pt: 'Fluxo dualband ou narrowband', en: 'Dualband or narrowband workflow' },
    desc: {
      pt: 'As bases do processamento de imagem dualband ou narrowband em PixInsight.',
      en: 'The basics of dualband or narrowband image processing in PixInsight.',
    },
    agenda: [
      { pt: 'Análise do stack', en: 'Stack analysis' },
      { pt: 'Visão geral do fluxo de trabalho', en: 'Workflow overview' },
      { pt: 'Corte da imagem', en: 'Cropping the image' },
      { pt: 'Image solver', en: 'Image solver' },
      { pt: 'Correção de estrelas', en: 'Star correction' },
      { pt: 'Remoção de gradientes', en: 'Gradient removal' },
      { pt: 'Calibração de cor (HOO)', en: 'Color calibration (HOO)' },
      { pt: 'Redução e sharpening de estrelas', en: 'Star reduction and sharpening' },
      { pt: 'Redução de ruído', en: 'Noise reduction' },
      { pt: 'Separar as estrelas', en: 'Separating the stars' },
      { pt: 'Stretch da imagem starless', en: 'Stretching the starless image' },
      { pt: 'Stretch das estrelas', en: 'Stretching the stars' },
      { pt: 'Máscaras de intervalo', en: 'Range masks' },
      { pt: 'Juntar estrelas e starless', en: 'Combining stars and starless' },
      { pt: 'Curvas', en: 'Curves' },
    ],
    needs: [
      { pt: 'Stacks dualband ou narrowband', en: 'Dualband or narrowband stacks' },
      { pt: 'PixInsight', en: 'PixInsight' },
      { pt: 'Scripts RC-Astro (opcional)', en: 'RC-Astro scripts (optional)' },
    ],
  },
  {
    code: '1.3',
    title: { pt: 'Crítica e edição da tua imagem', en: 'Critique and editing of your image' },
    desc: {
      pt: 'Para quem está preso numa imagem específica e quer conselhos e orientação a dois.',
      en: 'For anyone stuck on a specific image who wants advice and one-on-one guidance.',
    },
    agenda: [
      { pt: 'Análise do stack', en: 'Stack analysis' },
      { pt: 'Revisão do teu fluxo de trabalho', en: 'Review of your workflow' },
      { pt: 'Crítica da imagem', en: 'Image critique' },
      { pt: 'Edição a dois', en: 'Editing together' },
      { pt: 'Conselhos para chegares a melhores resultados', en: 'Advice to get better results' },
    ],
    needs: [
      { pt: 'Stacks a cor, dualband, mono ou narrowband', en: 'Color, dualband, mono or narrowband stacks' },
      { pt: 'PixInsight', en: 'PixInsight' },
      { pt: 'Scripts RC-Astro (opcional)', en: 'RC-Astro scripts (optional)' },
    ],
  },
];

const advanced: Topic[] = [
  {
    code: '2.1',
    title: { pt: 'Edição não destrutiva avançada', en: 'Advanced non-destructive editing' },
    desc: {
      pt: 'Levar a imagem mais além com técnicas de edição não destrutiva em Photoshop.',
      en: 'Taking the image further with non-destructive editing techniques in Photoshop.',
    },
    agenda: [
      { pt: 'Perceber camadas e camadas de ajuste', en: 'Understanding layers and adjustment layers' },
      { pt: 'Construir a imagem com canais em camadas', en: 'Building the image with layered channels' },
      { pt: 'Camadas de ajuste para afinar a intensidade', en: 'Adjustment layers to fine-tune intensity' },
      { pt: 'Curvas e máscaras', en: 'Curves and masks' },
      { pt: 'Camera Raw', en: 'Camera Raw' },
      { pt: 'Exportação', en: 'Export' },
    ],
    needs: [
      { pt: 'Imagem starless não linear (RGB, dualband ou narrowband)', en: 'Non-linear starless image (RGB, dualband or narrowband)' },
      { pt: 'Imagem de estrelas não linear (RGB, dualband ou narrowband)', en: 'Non-linear stars image (RGB, dualband or narrowband)' },
      { pt: 'Photoshop', en: 'Photoshop' },
    ],
  },
  {
    code: '2.2',
    title: { pt: 'Star stretch avançado, com spikes de difração', en: 'Advanced star stretch, with diffraction spikes' },
    desc: {
      pt: 'Os Newtonianos são famosos pelos spikes de difração. Como esticar as estrelas para os pôr bonitos.',
      en: 'Newtonians are famous for diffraction spikes. How to stretch stars to make them look good.',
    },
    agenda: [
      { pt: 'Porque é que as estrelas importam', en: 'Why stars matter' },
      { pt: 'Separar as estrelas', en: 'Separating the stars' },
      { pt: 'Stretch da imagem starless com GHS', en: 'Stretching the starless image with GHS' },
      { pt: 'Star stretch (HT) versus star stretch avançado (GHS)', en: 'Star stretch (HT) versus advanced star stretch (GHS)' },
      { pt: 'Juntar as estrelas ao starless, em Photoshop', en: 'Combining stars with starless, in Photoshop' },
      { pt: 'Fazer brilhar os spikes com curvas, em Photoshop', en: 'Making the spikes shine with curves, in Photoshop' },
    ],
    needs: [
      { pt: 'Stack OSC ou mono RGB com spikes de difração', en: 'OSC or mono RGB stack with diffraction spikes' },
      { pt: 'PixInsight', en: 'PixInsight' },
      { pt: 'Scripts RC-Astro', en: 'RC-Astro scripts' },
      { pt: 'Photoshop', en: 'Photoshop' },
    ],
  },
  {
    code: '2.3',
    title: { pt: 'Subtração de contínuo', en: 'Continuum subtraction' },
    desc: {
      pt: 'Misturar dados narrowband nos teus dados broadband, com subtração de contínuo em Photoshop.',
      en: 'Blending narrowband data into your broadband data, with continuum subtraction in Photoshop.',
    },
    agenda: [
      { pt: 'Perceber o conceito de subtração de contínuo', en: 'Understanding the continuum subtraction concept' },
      { pt: 'Juntar Ha ao RGB com subtração de contínuo', en: 'Combining Ha into RGB with continuum subtraction' },
      { pt: 'Camadas de ajuste para afinar e chegar ao melhor resultado', en: 'Adjustment layers to fine-tune and reach the best result' },
      { pt: 'Curvas', en: 'Curves' },
    ],
    needs: [
      { pt: 'Imagem RGB starless não linear', en: 'Non-linear RGB starless image' },
      { pt: 'Imagem RGB de estrelas não linear', en: 'Non-linear RGB stars image' },
      { pt: 'Imagem Ha starless não linear', en: 'Non-linear Ha starless image' },
      { pt: 'Photoshop', en: 'Photoshop' },
    ],
  },
];

const groups = [
  {
    label: t('editing.groupFoundationsLabel'),
    intro: t('editing.groupFoundationsIntro'),
    topics: foundations,
  },
  {
    label: t('editing.groupAdvancedLabel'),
    intro: t('editing.groupAdvancedIntro'),
    topics: advanced,
  },
];
---

<section id="temas" class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">{t('editing.topicsEyebrow')}</p>
    <h2
      class="reveal max-w-2xl text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl"
      style="--reveal-delay: 0.05s"
    >
      {t('editing.topicsTitle')}
    </h2>
    <p
      class="reveal mt-6 max-w-2xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
      style="--reveal-delay: 0.1s"
    >
      {t('editing.topicsDesc')}
    </p>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {
        groups.map((g, gi) => (
          <div class="reveal" style={`--reveal-delay: ${0.15 + gi * 0.05}s`}>
            <div class="flex items-baseline gap-3">
              <h3 class="text-xl font-bold">{g.label}</h3>
              <span class="h-px flex-1 bg-cream-50/12" aria-hidden="true" />
            </div>
            <p class="mt-2 text-sm text-cream-50/60">{g.intro}</p>

            <div class="mt-6 divide-y divide-cream-50/12 border-t border-cream-50/12">
              {g.topics.map((topic) => (
                <details class="group py-2 [&::-webkit-details-marker]:hidden">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-4">
                    <span>
                      <span class="flex items-baseline gap-2.5">
                        <span class="text-xs font-medium text-accent-200">{topic.code}</span>
                        <span class="font-medium text-cream-50">{topic.title[lang]}</span>
                      </span>
                      <span class="mt-1 block text-sm leading-relaxed text-cream-50/55">
                        {topic.desc[lang]}
                      </span>
                    </span>
                    <span class="shrink-0 pt-0.5 text-xl leading-none text-cream-50/60 transition-transform duration-200 group-open:rotate-45">
                      +
                    </span>
                  </summary>

                  <div class="grid gap-6 pb-5 sm:grid-cols-2">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/40">
                        {t('editing.agendaLabel')}
                      </p>
                      <ul class="mt-3 space-y-1.5">
                        {topic.agenda.map((a) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-cream-50/70">
                            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-300/70" aria-hidden="true" />
                            {a[lang]}
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/40">
                        {t('editing.needsLabel')}
                      </p>
                      <ul class="mt-3 space-y-1.5">
                        {topic.needs.map((n) => (
                          <li class="flex gap-2.5 text-sm leading-relaxed text-cream-50/70">
                            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cream-50/30" aria-hidden="true" />
                            {n[lang]}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
