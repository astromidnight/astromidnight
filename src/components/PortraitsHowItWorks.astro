---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const steps = [
  { n: '01', title: t('retratos.step1Title'), desc: t('retratos.step1Desc') },
  { n: '02', title: t('retratos.step2Title'), desc: t('retratos.step2Desc') },
  { n: '03', title: t('retratos.step3Title'), desc: t('retratos.step3Desc') },
  { n: '04', title: t('retratos.step4Title'), desc: t('retratos.step4Desc') },
];
---

<section class="relative border-y border-cream-50/8 bg-night-800/40 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">{t('howItWorks.eyebrow')}</p>
    <h2 class="reveal text-3xl font-bold tracking-[-0.02em] sm:text-4xl">
      {t('retratos.howItWorksTitle')}
    </h2>

    <div class="reveal mt-9 grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-10" style="--reveal-delay: 0.05s">
      {
        steps.map((s) => (
          <div class="border-t-2 border-cream-50/30 pt-5">
            <p class="text-sm font-medium text-cream-50/50">{s.n}</p>
            <p class="mt-1.5 text-xl font-bold">{s.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-50/70">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
