---
import { Image } from 'astro:assets';
import portrait from '../assets/About.jpg';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const stats = [
  { value: '3×', label: 'NASA APOD' },
  { value: '4×', label: 'Astrobin IOTD' },
  { value: '2×', label: 'ZWO IOTW' },
  { value: 'ESA', label: t('about.colaboracao') },
];
---

<section id="sobre" class="starfield relative py-24 sm:py-32">
  <div
    class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[5fr_7fr] lg:gap-20"
  >
    <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
      <div
        class="absolute -inset-3 rounded-2xl border border-accent-400/25 bg-night-900 lg:-inset-4"
        aria-hidden="true"
      >
      </div>
      <Image
        src={portrait}
        alt="David Cruz no observatório, à noite"
        class="relative aspect-[4/5] w-full rounded-xl object-cover"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 480px, 90vw"
      />
    </div>

    <div>
      <p class="eyebrow reveal mb-4">{t('nav.sobre')}</p>
      <h2
        class="reveal text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]"
        style="--reveal-delay: 0.05s"
      >
        {t('about.greeting')}<br />
        <span class="text-cream-50/60"
          >{t('about.instagramPrefix')} <a
            href="https://www.instagram.com/astro.midnight"
            target="_blank"
            rel="noopener"
            class="underline decoration-cream-50/30 underline-offset-4 hover:decoration-cream-50/60"
            >Astromidnight</a
          >.</span
        >
      </h2>
      <p
        class="reveal mt-6 max-w-xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
        style="--reveal-delay: 0.1s"
      >
        {t('about.desc')}
      </p>

      <p
        class="reveal mt-10 text-xs font-medium uppercase tracking-[0.14em] text-cream-50/55"
        style="--reveal-delay: 0.15s"
      >
        {t('about.reconhecimento')}
      </p>
      <dl
        class="reveal mt-4 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4"
        style="--reveal-delay: 0.15s"
      >
        {
          stats.map((s) => (
            <div class="border-l border-accent-400/30 pl-4">
              <dt class="sr-only">{s.label}</dt>
              <dd class="text-3xl font-bold tracking-tight text-accent-200 sm:text-4xl">
                {s.value}
              </dd>
              <dd class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-cream-50/55">
                {s.label}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="reveal mt-10 flex flex-wrap gap-4" style="--reveal-delay: 0.2s">
        <a href={localizeHref('/sobre', lang)} class="btn btn-primary">{t('about.ctaSobre')}</a>
        <a
          href="https://www.google.com/maps/search/?api=1&query=S%C3%A3o+Pedro+da+Gafanhoeira"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          {t('about.ctaMapa')}
        </a>
      </div>
    </div>
  </div>
</section>
