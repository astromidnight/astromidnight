---
// Google Analytics 4, só carrega com consentimento -- nunca antes do
// "Aceitar" no CookieBanner.astro (opt-in real, exigido pelo RGPD para
// cookies de analítica). Ouve o evento 'am-cookie-consent' disparado pelo
// banner, e também verifica o localStorage no arranque para visitas
// seguintes em que o consentimento já tinha sido dado.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{
  gaId && (
    <script define:vars={{ gaId }}>
      const CONSENT_KEY = 'am-cookie-consent';
      let loaded = false;

      function loadGA() {
        if (loaded) return;
        loaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      }

      if (localStorage.getItem(CONSENT_KEY) === 'accepted') loadGA();

      window.addEventListener('am-cookie-consent', (e) => {
        if (e.detail === 'accepted') loadGA();
      });
    </script>
  )
}
