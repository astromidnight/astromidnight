---
// Espaço reservado para imagens que ainda não existem. A borda tracejada é
// intencional: deixa claro que falta o asset, sem parecer que a página
// está partida. Substituir por <Image> assim que houver fotografias de uma
// sessão individual de astrofotografia.
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = 'aspect-[4/3]' } = Astro.props;
---

<div
  class:list={[
    'starfield flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-cream-50/20 bg-night-900 p-6 text-center',
    className,
  ]}
  role="img"
  aria-label={`Imagem por adicionar: ${label}`}
>
  <svg
    class="h-7 w-7 text-cream-50/25"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2.2l1.1-1.8A1 1 0 0 1 8.7 4.7h6.6a1 1 0 0 1 .9.5L17.3 7h2.2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z" />
    <circle cx="12" cy="12.8" r="3.3" />
  </svg>
  <span class="text-xs font-medium uppercase tracking-[0.18em] text-cream-50/35">
    {label}
  </span>
</div>
