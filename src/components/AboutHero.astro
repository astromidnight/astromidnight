---
import { Image } from 'astro:assets';
import portrait from '../assets/AboutMe.jpg';
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

// Contagens que batem certo com a lista completa em AboutAwards.astro
// (3 APOD, 4 IOTD, 2 IOTW, 1 ESA). Se lá for acrescentado um prémio novo,
// atualizar aqui também.
const stats = [
  { value: '3×', label: 'NASA APOD' },
  { value: '4×', label: 'Astrobin IOTD' },
  { value: '2×', label: 'ZWO IOTW' },
  { value: 'ESA', label: t('about.colaboracao') },
];
---

<section class="relative pb-16 sm:pb-20">
  <BreadcrumbSchema label={t('nav.sobre')} />
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="reveal text-sm text-cream-50/55">
      <a href={localizeHref('/', lang)} class="transition-colors hover:text-cream-50">{t('breadcrumb.inicio')}</a>
      <span class="mx-1.5">/</span>
      <span class="text-cream-50/80">{t('nav.sobre')}</span>
    </p>

    <div class="mt-10 grid items-center gap-12 lg:grid-cols-[6fr_5fr] lg:gap-20">
      <div>
        <p class="eyebrow reveal mb-4">{t('nav.sobre')}</p>
        <h1
          class="reveal max-w-2xl text-4xl font-bold leading-tight tracking-[-0.02em] sm:text-5xl lg:text-[3.25rem]"
          style="--reveal-delay: 0.05s"
        >
          {t('about.title')}
        </h1>
        <p
          class="reveal mt-6 max-w-xl text-base leading-relaxed text-cream-50/75 sm:text-lg"
          style="--reveal-delay: 0.1s"
        >
          {t('about.heroDesc')}
        </p>

        <dl
          class="reveal mt-10 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4"
          style="--reveal-delay: 0.15s"
        >
          {
            stats.map((s) => (
              <div class="border-l border-accent-400/30 pl-4">
                <dt class="sr-only">{s.label}</dt>
                <dd class="text-3xl font-bold tracking-tight text-accent-200 sm:text-4xl">
                  {s.value}
                </dd>
                <dd class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-cream-50/55">
                  {s.label}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none" style="--reveal-delay: 0.1s">
        <div
          class="absolute -inset-3 rounded-2xl border border-accent-400/25 bg-night-900 lg:-inset-4"
          aria-hidden="true"
        >
        </div>
        <Image
          src={portrait}
          alt={t('about.portraitAlt')}
          class="relative aspect-square w-full rounded-xl object-cover"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 480px, 90vw"
          priority
        />
      </div>
    </div>
  </div>
</section>
