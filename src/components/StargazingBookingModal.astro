---
// Popup de escolha de quantidade de adultos para o Stargazing, partilhado
// por qualquer página que tenha um botão/elemento com [data-open-stargazing]
// (mesma convenção usada em Calendar.astro e Pillar.astro). Standalone: não
// depende de dados do calendário, só dos links fixos do Cal.com.
import { STARGAZING_LINKS, STARGAZING_PRICE_PER_ADULT, calLinkPath } from '../lib/calcom';

const stargazingCalLinks = Object.fromEntries(
  Object.entries(STARGAZING_LINKS).map(([n, href]) => [n, calLinkPath(href)])
) as Record<'1' | '2' | '3' | '4', string>;
---

<div
  id="stargazing-modal"
  class="fixed inset-0 z-[60] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sg-title"
>
  <div class="modal-backdrop absolute inset-0 bg-night-950/80 backdrop-blur-sm"></div>
  <div class="relative w-full max-w-sm rounded-2xl border border-cream-50/12 bg-night-900 p-6 shadow-2xl">
    <button
      class="modal-close absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-cream-50/60 transition-colors hover:bg-night-800 hover:text-cream-50"
      aria-label="Fechar"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <p class="eyebrow">Observação Noturna</p>
    <h3 id="sg-title" class="mt-1 text-xl font-bold">Quantos adultos?</h3>
    <p class="mt-1 text-xs text-cream-50/45">Crianças não pagam.</p>

    <div id="sg-options" class="mt-5 space-y-2" role="radiogroup" aria-label="Número de adultos"></div>

    <button type="button" id="sg-continue" class="btn btn-primary mt-5 w-full">
      Continuar para reserva
    </button>
  </div>
</div>

<script define:vars={{ links: stargazingCalLinks, pricePerAdult: STARGAZING_PRICE_PER_ADULT }}>
  const $ = (id) => document.getElementById(id);
  const sgModal = $('stargazing-modal');
  const sgOptionsEl = $('sg-options');
  const sgContinue = $('sg-continue');
  let sgSelected = 1;

  const renderStargazingOptions = () => {
    sgOptionsEl.innerHTML = [1, 2, 3, 4]
      .map((n) => {
        const price = n * pricePerAdult;
        const active = n === sgSelected;
        return `
          <button
            type="button"
            data-adults="${n}"
            class="flex w-full items-center justify-between rounded-xl border px-4 py-3 text-left transition-colors ${
              active
                ? 'border-accent-300 bg-accent-400/10'
                : 'border-cream-50/15 hover:border-cream-50/30'
            }"
          >
            <span class="font-medium">${n} adulto${n > 1 ? 's' : ''}</span>
            <span class="font-bold">${price}€</span>
          </button>`;
      })
      .join('');
    sgOptionsEl.querySelectorAll('button[data-adults]').forEach((b) =>
      b.addEventListener('click', () => {
        sgSelected = Number(b.dataset.adults);
        renderStargazingOptions();
      })
    );
  };

  const openStargazingModal = () => {
    sgSelected = 1;
    renderStargazingOptions();
    sgModal.classList.remove('hidden');
    sgModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeStargazingModal = () => {
    sgModal.classList.add('hidden');
    sgModal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-open-stargazing]');
    if (trigger) {
      openStargazingModal();
      return;
    }
  });
  sgContinue.addEventListener('click', () => {
    closeStargazingModal();
    window.openCalModal(links[String(sgSelected)], {});
  });
  sgModal.querySelector('.modal-close').addEventListener('click', closeStargazingModal);
  sgModal.querySelector('.modal-backdrop').addEventListener('click', closeStargazingModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sgModal.classList.contains('hidden')) closeStargazingModal();
  });
</script>
