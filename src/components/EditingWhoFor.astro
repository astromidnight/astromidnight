---
// Os quatro perfis de "Who is this for?" do site atual, em PT-PT.
const cases = [
  'Tens dificuldade em editar os teus próprios dados.',
  'Andas perdido na quantidade esmagadora de tutoriais do YouTube.',
  'Queres orientação para tirar o máximo do processamento de céu profundo.',
  'Já trabalhas com o software, mas não gostas do resultado final.',
];
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow mb-4">Para quem é</p>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
          Isto é para ti se...
        </h2>
      </div>

      <ul class="reveal grid max-w-3xl gap-4 sm:grid-cols-2" style="--reveal-delay: 0.05s">
        {
          cases.map((c) => (
            <li class="flex gap-3 rounded-2xl border border-cream-50/10 bg-night-950/50 p-5">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-300" aria-hidden="true" />
              <span class="text-base leading-relaxed text-cream-50/80">{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
