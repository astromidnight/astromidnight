---
// Secção fullwidth de captação de leads para donos de alojamentos rurais
// que queiram sessões de observação no seu espaço, para os hóspedes/grupos.
// Envia por Web3Forms (web3forms.com) direto do browser -- sem servidor
// próprio, só a access_key pública (ver PUBLIC_WEB3FORMS_KEY no .env).
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_HOST_KEY;
const sendingLabel = t('hostSessions.sending');
const submitLabel = t('hostSessions.submit');
---

<section
  id="alojamentos"
  class="relative flex min-h-[70svh] items-center overflow-hidden border-y border-cream-50/8 py-24 sm:py-32"
>
  <video
    class="absolute inset-0 h-full w-full object-cover"
    src="/videos/starparty.mp4"
    poster="/posters/starparty.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    data-lazy
    aria-hidden="true"></video>

  <!-- Scrim leve: legibilidade do texto sem esconder o vídeo. Escurece só
       as bordas para fundir com as secções adjacentes. -->
  <div class="absolute inset-0 bg-night-950/30"></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-night-950/85 via-transparent to-night-950/85"
  >
  </div>

  <div class="relative mx-auto w-full max-w-3xl px-5 text-center sm:px-8">
    <p class="eyebrow reveal mb-5">{t('nav.alojamentos')}</p>
    <h2
      class="reveal text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl lg:text-[3rem]"
      style="--reveal-delay: 0.05s"
    >
      {t('hostSessions.title')}
    </h2>
    <p
      class="reveal mx-auto mt-6 max-w-xl text-base leading-relaxed text-cream-50/80 sm:text-lg"
      style="--reveal-delay: 0.1s"
    >
      {t('hostSessions.desc')}
    </p>

    <form
      id="host-form"
      class="reveal mx-auto mt-9 flex max-w-md flex-col gap-3 text-left"
      style="--reveal-delay: 0.15s"
    >
      <input type="hidden" name="subject" value={t('hostSessions.subject')} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />

      <label class="sr-only" for="host-name">{t('hostSessions.nameLabel')}</label>
      <input
        id="host-name"
        name="nome"
        type="text"
        required
        placeholder={t('hostSessions.namePlaceholder')}
        autocomplete="name"
        class="min-h-12 w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300"
      />
      <label class="sr-only" for="host-email">{t('hostSessions.emailLabel')}</label>
      <input
        id="host-email"
        name="email"
        type="email"
        required
        placeholder={t('hostSessions.emailPlaceholder')}
        autocomplete="email"
        class="min-h-12 w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300"
      />
      <label class="sr-only" for="host-details">{t('hostSessions.detailsLabel')}</label>
      <textarea
        id="host-details"
        name="detalhes"
        rows="4"
        required
        placeholder={t('hostSessions.detailsPlaceholder')}
        class="w-full rounded-2xl border border-cream-50/25 bg-night-950/60 px-5 py-3 text-cream-50 placeholder:text-cream-50/40 focus:border-accent-300"
      ></textarea>
      <button type="submit" id="host-submit" class="btn btn-primary mt-1 w-full">
        {t('hostSessions.submit')}
      </button>
    </form>

    <p
      id="host-note"
      class="reveal mt-4 hidden text-sm text-accent-200"
      role="status"
    >
      {t('hostSessions.success')}
    </p>
    <p
      id="host-error"
      class="reveal mt-4 hidden text-sm text-red-300"
      role="status"
    >
      {t('hostSessions.error')}
    </p>

    <p class="reveal mt-4 text-sm text-cream-50/50" style="--reveal-delay: 0.2s">
      {t('hostSessions.footerLine')}
    </p>
  </div>
</section>

<script define:vars={{ web3formsKey, sendingLabel, submitLabel }}>
  const form = document.getElementById('host-form');
  const submitBtn = document.getElementById('host-submit');
  const note = document.getElementById('host-note');
  const errorNote = document.getElementById('host-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    note.classList.add('hidden');
    errorNote.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = sendingLabel;

    try {
      const data = new FormData(form);
      data.append('access_key', web3formsKey);

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);

      note.classList.remove('hidden');
      form.reset();
    } catch (err) {
      console.warn('[host-form] falha ao enviar via Web3Forms:', err);
      errorNote.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  });
</script>
