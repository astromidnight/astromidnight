---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  price: string;
  priceNote?: string;
  ctaLabel: string;
  flip?: boolean;
  video?: { src: string; poster: string };
  image?: { src: ImageMetadata; alt: string };
  mediaAlt?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  price,
  priceNote,
  ctaLabel,
  flip = false,
  video,
  image,
} = Astro.props;
---

<section id={id} class="relative py-20 sm:py-24">
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:gap-24"
  >
    <div
      class:list={[
        'reveal group relative mx-auto w-full max-w-lg lg:max-w-none',
        flip && 'lg:order-2',
      ]}
    >
      <div
        class="overflow-hidden rounded-2xl border border-cream-50/10"
      >
        {
          video && (
            <video
              class="aspect-[3/4] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              src={video.src}
              poster={video.poster}
              muted
              loop
              playsinline
              autoplay
              preload="none"
              data-lazy
              aria-hidden="true"
            />
          )
        }
        {
          image && (
            <Image
              src={image.src}
              alt={image.alt}
              class="aspect-[3/4] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              widths={[560, 840, 1120]}
              sizes="(min-width: 1024px) 560px, 90vw"
            />
          )
        }
      </div>
    </div>

    <div class:list={[flip && 'lg:order-1']}>
      <p class="eyebrow reveal mb-4">{eyebrow}</p>
      <h2
        class="reveal max-w-md text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]"
        style="--reveal-delay: 0.05s"
      >
        {title}
      </h2>
      <p
        class="reveal mt-6 max-w-md text-base leading-relaxed text-cream-50/75 sm:text-lg"
        style="--reveal-delay: 0.1s"
      >
        {description}
      </p>
      <p class="reveal mt-8" style="--reveal-delay: 0.15s">
        <span class="text-3xl font-bold tracking-tight text-accent-200">{price}</span>
        {priceNote && <span class="ml-2 text-cream-50/55">{priceNote}</span>}
      </p>
      {
        id === 'stargazing' ? (
          <div class="reveal mt-8 flex flex-wrap items-center gap-5" style="--reveal-delay: 0.2s">
            <button type="button" data-open-stargazing class="btn btn-primary">
              {ctaLabel}
            </button>
            <a href="/observacao-noturna" class="btn btn-ghost">
              Saber mais
            </a>
          </div>
        ) : (
          <a
            href="#calendario"
            class="btn btn-primary reveal mt-8"
            style="--reveal-delay: 0.2s"
          >
            {ctaLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
