---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

// Os seis princípios de "Editing approach" do site atual, em PT-PT.
const principles = [
  { title: t('editing.principle1Title'), desc: t('editing.principle1Desc') },
  { title: t('editing.principle2Title'), desc: t('editing.principle2Desc') },
  { title: t('editing.principle3Title'), desc: t('editing.principle3Desc') },
  { title: t('editing.principle4Title'), desc: t('editing.principle4Desc') },
  { title: t('editing.principle5Title'), desc: t('editing.principle5Desc') },
  { title: t('editing.principle6Title'), desc: t('editing.principle6Desc') },
];
---

<section class="relative border-t border-cream-50/8 bg-night-900 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="eyebrow reveal mb-4">{t('editing.approachEyebrow')}</p>
    <h2
      class="reveal max-w-2xl text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl"
      style="--reveal-delay: 0.05s"
    >
      {t('editing.approachTitle')}
    </h2>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((p, i) => (
          <li
            class="reveal rounded-2xl border border-cream-50/10 bg-night-950/50 p-6"
            style={`--reveal-delay: ${Math.min(i, 3) * 0.05}s`}
          >
            <p class="font-medium text-cream-50">{p.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-50/60">{p.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
