---
import { Image } from 'astro:assets';
import couple from '../assets/PortraitsCouple.jpg';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const items = [
  t('retratos.item1'),
  t('retratos.item2'),
  t('retratos.item3'),
  t('retratos.item4'),
];
---

<section class="relative border-t border-cream-50/8 py-16 sm:py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:gap-24">
    <div class="reveal mx-auto w-full max-w-lg lg:max-w-none">
      <p class="eyebrow mb-4">{t('stargazing.included')}</p>
      <h2 class="max-w-md text-3xl font-bold leading-tight tracking-[-0.02em] sm:text-4xl">
        {t('stargazing.includedTitle')}
      </h2>

      <ul class="mt-8 space-y-4">
        {
          items.map((item) => (
            <li class="flex items-start gap-3 text-cream-50/80">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-300" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 border-l-2 border-accent-400/50 pl-5">
        <h3 class="font-bold text-accent-200">{t('retratos.notCasual')}</h3>
        <p class="mt-1 text-sm text-cream-50/70">
          {t('retratos.notCasualDesc')}
        </p>
      </div>
    </div>

    <div class="reveal mx-auto w-full max-w-lg lg:order-2 lg:max-w-none" style="--reveal-delay: 0.1s">
      <div class="overflow-hidden rounded-2xl border border-cream-50/10">
        <Image
          src={couple}
          alt={t('retratos.includedImgAlt')}
          class="aspect-[4/5] w-full object-cover"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 560px, 90vw"
        />
      </div>
    </div>
  </div>
</section>
