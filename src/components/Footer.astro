---
import { Image } from 'astro:assets';
import logo from '../assets/Logo.png';

const columns = [
  [
    { label: 'Stargazing', href: '#stargazing' },
    { label: 'Loja', href: '#loja' },
  ],
  [
    { label: 'Retratos', href: '#retratos' },
    { label: 'Galeria', href: '#galeria' },
  ],
  [
    { label: 'Workshops', href: '#workshops' },
    { label: 'Sobre', href: '#sobre' },
  ],
  [
    { label: 'Contacto', href: '#contacto' },
  ],
];

const legal = [
  { label: 'Instagram', href: 'https://www.instagram.com/astro.midnight/' },
  { label: 'Astrobin', href: '#galeria' },
  { label: 'Termos', href: '#' },
  { label: 'Privacidade', href: '#' },
];
---

<footer id="contacto" class="starfield border-t border-cream-50/8 bg-night-950 pb-10 pt-16">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div>
        <Image src={logo} alt="Astromidnight" class="h-10 w-auto" densities={[1, 2]} />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream-50/55">
          Observatório privado, Alentejo, Portugal.
        </p>
      </div>

      <nav
        class="grid grid-cols-2 gap-x-12 gap-y-2 sm:grid-cols-4"
        aria-label="Navegação do rodapé"
      >
        {
          columns.map((col) => (
            <div class="flex flex-col gap-2">
              {col.map((item) => (
                <a
                  href={item.href}
                  class="py-1 text-sm text-cream-50/60 transition-colors hover:text-accent-200"
                >
                  {item.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-cream-50/8 pt-7 sm:flex-row sm:items-center"
    >
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legal.map((item) => (
            <a
              href={item.href}
              class="text-sm text-cream-50/45 transition-colors hover:text-accent-200"
              {...(item.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener' }
                : {})}
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <p class="text-sm text-cream-50/35">
        © {new Date().getFullYear()} Astromidnight · David Cruz
      </p>
    </div>
  </div>
</footer>
