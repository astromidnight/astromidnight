---
import { Image } from 'astro:assets';
import logo from '../assets/Logo.png';
import { useTranslations, localizeHref } from '../i18n/utils';

const lang = Astro.currentLocale ?? 'pt';
const t = useTranslations(lang);

const columns = [
  {
    heading: t('nav.experiencias'),
    items: [
      { label: t('nav.observacao'), href: '/observacao-noturna' },
      { label: t('nav.retratos'), href: '/retratos' },
      { label: t('nav.alojamentos'), href: '/#alojamentos' },
    ],
  },
  {
    heading: t('nav.aprende'),
    items: [
      { label: t('nav.astrofotografia'), href: '/astrofotografia' },
      { label: t('nav.edicao'), href: '/edicao-de-imagem' },
    ],
  },
  {
    heading: null,
    items: [
      { label: t('nav.loja'), href: '/loja' },
      { label: t('nav.sobre'), href: '/sobre' },
      { label: t('nav.contacto'), href: '/contacto' },
    ],
  },
];

const legal = [
  { label: t('footer.instagram'), href: 'https://www.instagram.com/astro.midnight/' },
  { label: t('footer.astrobin'), href: 'https://app.astrobin.com/u/astro.midnight' },
  { label: t('footer.termos'), href: '/termos' },
  { label: t('footer.privacidade'), href: '/privacidade' },
];
---

<footer id="contacto" class="starfield border-t border-cream-50/8 bg-night-950 pb-10 pt-16">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div>
        <Image src={logo} alt="Astromidnight" class="h-10 w-auto" densities={[1, 2]} />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream-50/55">
          {t('footer.tagline')}
        </p>
      </div>

      <nav
        class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-3"
        aria-label={t('footer.nav')}
      >
        {
          columns.map((col) => (
            <div class="flex flex-col gap-2">
              {col.heading && (
                <p class="mb-1 text-sm font-medium text-cream-50/85">{col.heading}</p>
              )}
              {col.items.map((item) => (
                <a
                  href={localizeHref(item.href, lang)}
                  class="py-1 text-sm text-cream-50/60 transition-colors hover:text-accent-200"
                >
                  {item.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-cream-50/8 pt-7 sm:flex-row sm:items-center"
    >
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legal.map((item) => (
            <a
              href={localizeHref(item.href, lang)}
              class="text-sm text-cream-50/45 transition-colors hover:text-accent-200"
              {...(item.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener' }
                : {})}
            >
              {item.label}
            </a>
          ))
        }
        <button
          type="button"
          id="footer-manage-cookies"
          class="text-sm text-cream-50/45 transition-colors hover:text-accent-200"
        >
          {t('footer.geriCookies')}
        </button>
      </div>
      <p class="text-sm text-cream-50/35">
        © {new Date().getFullYear()} Astromidnight · David Cruz
      </p>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-manage-cookies')!.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('am-cookie-manage'));
  });
</script>
