---
import calendar from '../data/calendar.json';
import { moonPhasesInMonth, moonIlluminationByDay, type PhaseType } from '../lib/moon';
import { milkyWayVisible, darkSkyWindow, nightQuality } from '../lib/sky';
import { getLumaEvents, type LumaEvent } from '../lib/luma';
import {
  getAvailability,
  isAvailable,
  getSlotTime,
  calLinkPath,
  CAL_LINKS,
  STARGAZING_LINKS,
  STARGAZING_PRICE_PER_ADULT,
  type ServiceType,
} from '../lib/calcom';

// Quantos meses para a frente se pode navegar.
const MONTHS_AHEAD = 6;

// Dados reais, obtidos no momento do build: eventos de data fixa do Luma e
// disponibilidade dos 4 produtos do Cal.com (ver src/lib/luma.ts e
// src/lib/calcom.ts).
const lumaEvents = await getLumaEvents();
const availability = await getAvailability();

const weekdays = ['S', 'T', 'Q', 'Q', 'S', 'S', 'D'];
const WEEKDAYS_PT = [
  'Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado',
];
const MONTHS_PT = [
  'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
  'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro',
];

// Mês atual, em hora de Lisboa (resolvido no build)
const nowParts = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Lisbon',
  year: 'numeric',
  month: 'numeric',
  day: 'numeric',
}).formatToParts(new Date());
const part = (t: string) => Number(nowParts.find((p) => p.type === t)!.value);
const CUR_Y = part('year');
const CUR_M = part('month');
const TODAY = part('day');

// SVG de cada fase — parte iluminada a claro sobre disco escuro
const moonSvg = (type: PhaseType) => {
  const ring =
    '<circle cx="8" cy="8" r="7" fill="#121212" stroke="currentColor" stroke-width="1"/>';
  const inner =
    type === 'new'
      ? ring
      : type === 'full'
        ? '<circle cx="8" cy="8" r="7" fill="currentColor"/>'
        : type === 'first'
          ? ring + '<path d="M8 1 A7 7 0 0 1 8 15 Z" fill="currentColor"/>'
          : ring + '<path d="M8 1 A7 7 0 0 0 8 15 Z" fill="currentColor"/>';
  return `<svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true">${inner}</svg>`;
};

// Ícone de nuvem para a legenda — mesma técnica do moonSvg (stroke em
// currentColor, sem cor cromática, para bater certo com o resto do tema).
const cloudSvg =
  '<svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true"><path d="M4.5 12.5a2.5 2.5 0 0 1-.3-4.98 3 3 0 0 1 5.6-1.7A2.6 2.6 0 0 1 13 8.4a2.1 2.1 0 0 1-.1 4.1H4.5Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const legend: { type: PhaseType; label: string }[] = [
  { type: 'new', label: 'Lua Nova' },
  { type: 'first', label: 'Quarto Crescente' },
  { type: 'full', label: 'Lua Cheia' },
  { type: 'last', label: 'Quarto Minguante' },
];

const nightRange = (w: { start: number; end: number }, name: string) =>
  w.start === w.end ? `${w.start} ${name}` : `${w.start}–${w.end} ${name}`;

// Atividades reserváveis numa noite, em função da lua.
// Stargazing acontece sempre; Retratos só com pouca ou nenhuma lua.
type Service = {
  name: string;
  type: ServiceType;
  price: string;
  desc: string;
  available: boolean;
  href: string;
  dateKey: string;
  slotTime?: string;
};

// Link de reserva para uma data: com hora de horário conhecida (`slotTime`),
// salta o calendário do Cal.com e abre já no formulário de dados (ver
// packages/features/bookings/Booker/store.ts do Cal.com -- o
// `selectedTimeslot` é lido do query param `slot` no arranque, o que faz o
// Booker mostrar logo o passo do formulário). Sem hora conhecida (API sem
// chave, ou dia sem disponibilidade consultada), cai para o calendário
// normal do Cal.com com a data pré-selecionada.
const bookingHref = (baseHref: string, dateKey: string, slotTime?: string) =>
  slotTime
    ? `${baseHref}?date=${dateKey}&month=${dateKey.slice(0, 7)}&slot=${encodeURIComponent(slotTime)}`
    : `${baseHref}?date=${dateKey}`;

const servicesForNight = (illum: number, dateKey: string) => {
  const stargazingSlot = getSlotTime(availability, 'stargazing', dateKey);
  const s: Service[] = [
    {
      name: 'Observação Noturna',
      type: 'stargazing',
      price: `desde ${STARGAZING_PRICE_PER_ADULT}€ por adulto`,
      desc:
        illum <= 15
          ? 'Deep-sky, nebulosas e a Via Láctea no telescópio de 250mm.'
          : illum <= 60
            ? 'Planetas, enxames estelares e objetos brilhantes.'
            : 'A Lua ao detalhe e os planetas do momento.',
      available: isAvailable(availability, 'stargazing', dateKey),
      href: bookingHref(CAL_LINKS.stargazing, dateKey, stargazingSlot),
      dateKey,
      slotTime: stargazingSlot,
    },
  ];
  if (illum <= 15) {
    const retratosSlot = getSlotTime(availability, 'retratos', dateKey);
    s.push({
      name: 'Retratos sob as Estrelas',
      type: 'retratos',
      price: '160€',
      desc: 'O teu retrato sob um céu cheio de estrelas. Só em noites de pouca ou nenhuma lua.',
      available: isAvailable(availability, 'retratos', dateKey),
      href: bookingHref(CAL_LINKS.retratos, dateKey, retratosSlot),
      dateKey,
      slotTime: retratosSlot,
    });
  }
  return s;
};

// Constrói tudo o que é preciso para renderizar um mês (grelha, insights,
// painel do céu e dados das noites para o modal).
function buildMonth(y: number, m: number) {
  const monthName = MONTHS_PT[m - 1];
  const monthLabel = `${monthName} ${y}`;
  const todayDay = y === CUR_Y && m === CUR_M ? TODAY : -1;

  const daysInMonth = new Date(y, m, 0).getDate();
  const leading = (new Date(y, m - 1, 1).getDay() + 6) % 7;

  const phasesByDay = new Map<
    number,
    ReturnType<typeof moonPhasesInMonth>[number]
  >();
  for (const p of moonPhasesInMonth(y, m)) phasesByDay.set(p.day, p);

  const illumByDay = moonIlluminationByDay(y, m);
  const milkyWay = milkyWayVisible(m);
  const darkWindow = darkSkyWindow(illumByDay);
  const darkLabel = darkWindow ? nightRange(darkWindow, monthName) : null;
  const fullMoon = [...phasesByDay.values()].find((p) => p.type === 'full');

  // Eventos de data fixa do Luma que caem neste mês
  const evByDay = new Map<number, LumaEvent[]>();
  for (const ev of lumaEvents) {
    if (ev.year !== y || ev.month !== m) continue;
    const list = evByDay.get(ev.day) ?? [];
    list.push(ev);
    evByDay.set(ev.day, list);
  }

  const cells: (number | null)[] = [
    ...Array.from({ length: leading }, () => null),
    ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
  ];
  while (cells.length % 7 !== 0) cells.push(null);

  const rc = cells.map((day) => {
    if (day === null) return { day: null as null };
    const illum = illumByDay.get(day)!.illum;
    const phase = phasesByDay.get(day);
    const inDark =
      !!darkWindow && day >= darkWindow.start && day <= darkWindow.end;
    return {
      day,
      illum,
      wash: (Math.pow(illum / 100, 0.85) * 0.11).toFixed(3),
      phaseType: phase?.type ?? null,
      phaseLabel: phase?.label ?? null,
      phaseTime: phase?.time ?? null,
      isToday: day === todayDay,
      isPast: y === CUR_Y && m === CUR_M && day < TODAY,
      inDark,
      verdict: nightQuality(illum).verdict,
      events: evByDay.get(day) ?? [],
    };
  });

  const nights: Record<number, unknown> = {};
  for (let d = 1; d <= daysInMonth; d++) {
    const { illum, waxing } = illumByDay.get(d)!;
    const q = nightQuality(illum);
    const dateKey = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    nights[d] = {
      day: d,
      dateKey,
      weekday: WEEKDAYS_PT[new Date(y, m - 1, d).getDay()],
      dateLabel: `${d} de ${monthName} de ${y}`,
      illum,
      waxing,
      tone: q.tone,
      verdict: q.verdict,
      phase: phasesByDay.get(d)?.label ?? null,
      phaseTime: phasesByDay.get(d)?.time ?? null,
      services: servicesForNight(illum, dateKey),
      events: (evByDay.get(d) ?? []).map((e) => ({
        title: e.title,
        typeLabel: e.typeLabel,
        price: e.price,
        href: e.href,
      })),
    };
  }

  return {
    monthLabel,
    monthName,
    rc,
    todayDay,
    darkWindow,
    darkLabel,
    fullMoon,
    milkyWay,
    nights,
  };
}

const addMonths = (y: number, m: number, n: number) => {
  const idx = m - 1 + n;
  return { y: y + Math.floor(idx / 12), m: (idx % 12) + 1 };
};

const months = Array.from({ length: MONTHS_AHEAD + 1 }, (_, i) => {
  const { y, m } = addMonths(CUR_Y, CUR_M, i);
  return buildMonth(y, m);
});
const lastIndex = months.length - 1;

const stargazingCalLinks = Object.fromEntries(
  Object.entries(STARGAZING_LINKS).map(([n, href]) => [n, calLinkPath(href)])
) as Record<'1' | '2' | '3' | '4', string>;

const calendarData = {
  stargazingLinks: stargazingCalLinks,
  stargazingPricePerAdult: STARGAZING_PRICE_PER_ADULT,
  months: months.map((mv) => ({
    monthLabel: mv.monthLabel,
    milkyWay: mv.milkyWay,
    nights: mv.nights,
  })),
};

const listItems = [...lumaEvents, ...calendar.evergreen];
// Link externo (Luma) vs. reserva no Cal.com: os primeiros abrem numa aba
// nova, os segundos abrem no modal partilhado (ver data-book-link em
// CalBookingModal.astro).
const isExternalItem = (item: (typeof listItems)[number]) => 'href' in item;
const listHref = (item: (typeof listItems)[number]) =>
  isExternalItem(item) ? item.href : CAL_LINKS[item.type as ServiceType];
const listCalLink = (item: (typeof listItems)[number]) => calLinkPath(listHref(item));
---

<section id="calendario" class="relative py-24 sm:py-32">
  <script type="application/json" id="calendar-data" set:html={JSON.stringify(calendarData)}
  ></script>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <p class="eyebrow mb-4">Calendário</p>
        <h2 class="text-3xl font-bold tracking-[-0.02em] sm:text-4xl lg:text-[2.75rem]">
          As próximas noites
        </h2>
        <p class="mt-4 max-w-lg text-cream-50/70">
          Fases da lua e escuridão do céu, noite a noite. Escolhe uma
          data para veres as condições e reservares o teu lugar.
        </p>
      </div>

      <div
        class="reveal inline-flex shrink-0 rounded-full border border-cream-50/15 p-1"
        role="tablist"
        aria-label="Vista do calendário"
        style="--reveal-delay: 0.12s"
      >
        <button
          class="view-btn btn !min-h-0 !px-5 !py-2 text-sm"
          data-view="grid"
          role="tab"
          aria-selected="true">Calendário</button
        >
        <button
          class="view-btn btn !min-h-0 !px-5 !py-2 text-sm"
          data-view="cards"
          role="tab"
          aria-selected="false">Lista</button
        >
      </div>
    </div>

    <!-- Vista: grelha mensal (um bloco por mês) -->
    <div data-panel="grid" class="reveal mt-6" style="--reveal-delay: 0.15s">
      {
        months.map((mv, i) => (
          <div class="month-grid" data-i={i} class:list={[i > 0 && 'hidden']}>
            <div class="overflow-hidden rounded-2xl border border-cream-50/10 bg-night-900">
              <div class="flex items-center justify-between border-b border-cream-50/10 px-4 py-4 sm:px-6 sm:py-5">
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <button
                    class="cal-prev flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-cream-50/15 text-cream-50/70 transition-colors hover:border-accent-300/50 hover:text-cream-50 disabled:cursor-not-allowed disabled:opacity-25 disabled:hover:border-cream-50/15 disabled:hover:text-cream-50/70"
                    data-i={i}
                    disabled={i === 0}
                    aria-label="Mês anterior"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                  </button>
                  <h3 class="min-w-[8.5rem] text-center text-lg font-bold tracking-tight">
                    {mv.monthLabel}
                  </h3>
                  <button
                    class="cal-next flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-cream-50/15 text-cream-50/70 transition-colors hover:border-accent-300/50 hover:text-cream-50 disabled:cursor-not-allowed disabled:opacity-25 disabled:hover:border-cream-50/15 disabled:hover:text-cream-50/70"
                    data-i={i}
                    disabled={i === lastIndex}
                    aria-label="Mês seguinte"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
                  </button>
                </div>
                <p class="hidden text-xs uppercase tracking-[0.18em] text-cream-50/40 sm:block">
                  Seleciona uma noite
                </p>
              </div>
              <div class="grid grid-cols-7 border-b border-cream-50/10">
                {weekdays.map((d) => (
                  <div class="px-2 py-3 text-center text-xs font-medium uppercase tracking-[0.14em] text-cream-50/40">
                    {d}
                  </div>
                ))}
              </div>
              <div class="grid grid-cols-7">
                {mv.rc.map((cell) =>
                  cell.day === null ? (
                    <div class="min-h-16 border-b border-r border-cream-50/5 bg-night-950/40 p-2 sm:min-h-24 [&:nth-child(7n)]:border-r-0" />
                  ) : (
                    <button
                      type="button"
                      disabled={cell.isPast}
                      class:list={[
                        'day-cell relative min-h-16 border-b border-r border-cream-50/5 p-2 text-left transition-shadow sm:min-h-24 [&:nth-child(7n)]:border-r-0',
                        cell.isPast
                          ? 'cursor-not-allowed opacity-35'
                          : 'cursor-pointer hover:ring-1 hover:ring-inset hover:ring-accent-300/50',
                        cell.isToday
                          ? 'ring-1 ring-inset ring-accent-300/40'
                          : cell.inDark && 'ring-1 ring-inset ring-accent-300/20',
                      ]}
                      style={`background-color: rgba(232,232,232,${cell.wash})`}
                      data-i={i}
                      data-day={cell.day}
                      aria-label={`${cell.day} de ${mv.monthName} — ${cell.isPast ? 'já passou' : `${cell.verdict}, lua ${cell.illum}%`}`}
                    >
                      <span
                        class:list={[
                          'text-xs',
                          cell.isToday
                            ? 'font-semibold text-accent-200'
                            : cell.events.length || cell.inDark
                              ? 'font-medium text-cream-50'
                              : 'text-cream-50/40',
                        ]}
                      >
                        {cell.day}
                      </span>
                      {cell.phaseType && (
                        <span
                          class="absolute right-2 top-1/2 h-5 w-5 shrink-0 -translate-y-1/2 text-cream-50 sm:h-6 sm:w-6"
                          role="img"
                          aria-label={`${cell.phaseLabel} (${cell.phaseTime})`}
                          title={`${cell.phaseLabel} · ${cell.phaseTime}`}
                          set:html={moonSvg(cell.phaseType)}
                        />
                      )}
                      <span
                        class="weather-badge hidden absolute inset-x-2 bottom-2 items-center justify-end gap-1 text-[0.6rem] leading-tight text-cream-50/55 sm:text-xs"
                        data-weather-badge
                      >
                        <span class="whitespace-nowrap" data-weather-text />
                        <span class="hidden whitespace-nowrap lg:inline">&nbsp;de nuvens</span>
                        <span class="h-3 w-3 shrink-0" aria-hidden="true" data-weather-icon />
                      </span>
                      {cell.events.map((ev) => (
                        <span
                          class="day-event mt-1.5 block truncate rounded bg-accent-400/15 px-1.5 py-1 text-[0.65rem] leading-tight text-accent-200"
                          data-type={ev.type}
                          title={ev.title}
                        >
                          <span class="mr-1 inline-block h-1.5 w-1.5 rounded-full bg-accent-300" />
                          <span class="hidden sm:inline">{ev.title}</span>
                        </span>
                      ))}
                    </button>
                  )
                )}
              </div>
            </div>

            <!-- Legendas -->
            <div class="mt-6 flex flex-wrap items-start gap-x-6 gap-y-3">
              {legend.map((l) => (
                <span class="inline-flex items-center gap-2 text-xs text-cream-50/70">
                  <span class="h-5 w-5 shrink-0 text-cream-50" aria-hidden="true" set:html={moonSvg(l.type)} />
                  {l.label}
                </span>
              ))}
              <span class="inline-flex items-center gap-2 text-xs text-cream-50/70">
                <span class="h-5 w-5 shrink-0 text-cream-50" aria-hidden="true" set:html={cloudSvg} />
                Previsão meteorológica
              </span>

              <div class="ml-auto flex items-center gap-3">
                <div class="text-right">
                  <p class="text-xs font-medium text-cream-50/80">Escuro</p>
                  <p class="text-[11px] text-cream-50/50">Melhor para céu profundo</p>
                </div>
                <span
                  class="h-3.5 w-24 shrink-0 rounded-full border border-cream-50/15"
                  style="background: linear-gradient(90deg, #141414, rgba(232,232,232,0.14))"
                />
                <div>
                  <p class="text-xs font-medium text-cream-50/80">Luar</p>
                  <p class="text-[11px] text-cream-50/50">Melhor para Lua e Planetas</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Lista de próximos itens -->
      <ul class="mt-8 divide-y divide-cream-50/8 border-y border-cream-50/8">
        {
          listItems.map((item) => {
            const hasDate = item.dateLabel !== 'Sempre';
            return (
              <li
                class:list={[
                  'list-row -mx-4 grid items-center gap-x-5 gap-y-3 rounded-lg px-4 py-5 transition-colors duration-300 hover:bg-night-900 sm:-mx-6 sm:gap-x-8 sm:px-6',
                  // Uma coluna a menos desde que o chip de tipo saiu daqui:
                  // data (opcional), texto, preço e botão.
                  hasDate
                    ? 'grid-cols-[auto_1fr] sm:grid-cols-[6rem_1fr_auto_auto]'
                    : 'grid-cols-1 sm:grid-cols-[1fr_auto_auto]',
                ]}
                data-type={item.type}
              >
                {hasDate && (
                  <span class="text-sm font-bold uppercase tracking-wide text-accent-200">
                    {item.dateLabel}
                  </span>
                )}
                <div>
                  <p class="font-medium">{item.title}</p>
                  {'subtitle' in item && item.subtitle && (
                    <p class="mt-0.5 text-sm text-cream-50/55">{item.subtitle}</p>
                  )}
                </div>
                <span
                  class:list={[
                    // Empilhado e encostado à direita a partir de sm: assim os
                    // preços de todas as linhas alinham pela mesma margem, que
                    // o "por adulto" inline desalinhava. Em mobile a linha é
                    // uma coluna só, por isso fica tudo à esquerda como o resto.
                    'flex flex-col leading-tight sm:col-start-auto sm:items-end sm:text-right',
                    hasDate ? 'col-start-2' : 'col-start-1',
                  ]}
                >
                  <span class="text-lg font-bold text-cream-50">{item.price}</span>
                  {'priceUnit' in item && item.priceUnit && (
                    <span class="mt-0.5 text-sm text-cream-50/50">{item.priceUnit}</span>
                  )}
                </span>
                {item.type === 'stargazing' ? (
                  <button
                    type="button"
                    data-open-stargazing
                    class:list={[
                      'btn btn-ghost w-fit !min-h-0 !px-5 !py-2 text-sm sm:col-start-auto',
                      hasDate ? 'col-start-2' : 'col-start-1',
                    ]}
                  >
                    {item.cta}
                  </button>
                ) : isExternalItem(item) ? (
                  <a
                    href={listHref(item)}
                    target="_blank"
                    rel="noopener"
                    class:list={[
                      'btn btn-ghost w-fit !min-h-0 !px-5 !py-2 text-sm sm:col-start-auto',
                      hasDate ? 'col-start-2' : 'col-start-1',
                    ]}
                  >
                    {item.cta}
                  </a>
                ) : (
                  <button
                    type="button"
                    data-book-link={listCalLink(item)}
                    class:list={[
                      'btn btn-ghost w-fit !min-h-0 !px-5 !py-2 text-sm sm:col-start-auto',
                      hasDate ? 'col-start-2' : 'col-start-1',
                    ]}
                  >
                    {item.cta}
                  </button>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>

    <!-- Vista: cards -->
    <div
      data-panel="cards"
      class="mt-10 hidden grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        listItems.map((item) => (
          <article
            class="card-item flex flex-col rounded-2xl border border-cream-50/10 bg-night-900 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400/40"
            data-type={item.type}
          >
            <div class="flex items-center justify-between">
              <span class="rounded-full border border-cream-50/15 px-3 py-1 text-xs text-cream-50/60">
                {item.typeLabel}
              </span>
              <span class="text-sm font-bold uppercase tracking-wide text-accent-200">
                {item.dateLabel !== 'Sempre' && item.dateLabel}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-bold leading-snug">{item.title}</h3>
            {'subtitle' in item && item.subtitle && (
              <p class="mt-1.5 text-sm text-cream-50/55">{item.subtitle}</p>
            )}
            <div class="mt-auto flex items-center justify-between pt-6">
              <span>
                <span class="text-2xl font-bold">{item.price}</span>
                {'priceUnit' in item && item.priceUnit && (
                  <span class="ml-1 text-sm text-cream-50/50">{item.priceUnit}</span>
                )}
              </span>
              {item.type === 'stargazing' ? (
                <button
                  type="button"
                  data-open-stargazing
                  class="btn btn-primary !min-h-0 !px-5 !py-2 text-sm"
                >
                  {item.cta}
                </button>
              ) : isExternalItem(item) ? (
                <a
                  href={listHref(item)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-primary !min-h-0 !px-5 !py-2 text-sm"
                >
                  {item.cta}
                </a>
              ) : (
                <button
                  type="button"
                  data-book-link={listCalLink(item)}
                  class="btn btn-primary !min-h-0 !px-5 !py-2 text-sm"
                >
                  {item.cta}
                </button>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Detalhe da noite -->
  <div
    id="night-modal"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nm-title"
  >
    <div class="modal-backdrop absolute inset-0 bg-night-950/80 backdrop-blur-sm"></div>
    <div
      class="relative max-h-[85vh] w-full max-w-md overflow-y-auto rounded-2xl border border-cream-50/12 bg-night-900 p-6 shadow-2xl"
    >
      <button
        class="modal-close absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-cream-50/60 transition-colors hover:bg-night-800 hover:text-cream-50"
        aria-label="Fechar"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <p id="nm-weekday" class="text-xs uppercase tracking-[0.18em] text-accent-200"></p>
      <h3 id="nm-title" class="mt-1 text-2xl font-bold"></h3>
      <div class="mt-5 flex items-center gap-3">
        <span id="nm-moon" class="h-9 w-9 shrink-0 text-cream-50"></span>
        <div>
          <p id="nm-verdict" class="font-medium"></p>
          <p id="nm-moontext" class="text-sm text-cream-50/60"></p>
        </div>
      </div>
      <ul id="nm-sky" class="mt-4 space-y-1.5 text-sm text-cream-50/70"></ul>
      <div class="mt-5">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/40">
          Ideal para
        </p>
        <div id="nm-activities" class="space-y-2.5"></div>
      </div>
    </div>
  </div>

  <!-- Popup de quantidade — Stargazing -->
  <div
    id="stargazing-modal"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sg-title"
  >
    <div class="modal-backdrop absolute inset-0 bg-night-950/80 backdrop-blur-sm"></div>
    <div
      class="relative w-full max-w-sm rounded-2xl border border-cream-50/12 bg-night-900 p-6 shadow-2xl"
    >
      <button
        class="modal-close absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-cream-50/60 transition-colors hover:bg-night-800 hover:text-cream-50"
        aria-label="Fechar"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <p class="eyebrow">Observação Noturna</p>
      <h3 id="sg-title" class="mt-1 text-xl font-bold">Quantos adultos?</h3>
      <p id="sg-date" class="mt-1 hidden text-sm text-cream-50/55"></p>
      <p class="mt-1 text-xs text-cream-50/45">Crianças não pagam.</p>

      <div id="sg-options" class="mt-5 space-y-2" role="radiogroup" aria-label="Número de adultos"></div>

      <button type="button" id="sg-continue" class="btn btn-primary mt-5 w-full">
        Continuar para reserva
      </button>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('calendario')!;
  const viewBtns = section.querySelectorAll<HTMLButtonElement>('.view-btn');
  const panels = section.querySelectorAll<HTMLElement>('[data-panel]');
  const activeView = ['bg-accent-400', 'text-night-950', 'font-medium'];

  const setView = (view: string) => {
    viewBtns.forEach((b) => {
      const on = b.dataset.view === view;
      b.classList.toggle('text-cream-50/70', !on);
      activeView.forEach((c) => b.classList.toggle(c, on));
      b.setAttribute('aria-selected', String(on));
    });
    panels.forEach((p) => {
      const on = p.dataset.panel === view;
      p.classList.toggle('hidden', !on);
      if (p.dataset.panel === 'cards') p.classList.toggle('grid', on);
    });
  };
  viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view!)));
  setView('grid');

  // ---- Navegação entre meses ----
  const monthBlocks = section.querySelectorAll<HTMLElement>('.month-grid');
  const lastIndex = Math.max(
    0,
    ...[...monthBlocks].map((el) => Number(el.dataset.i))
  );
  let active = 0;
  const showMonth = (i: number) => {
    active = Math.max(0, Math.min(lastIndex, i));
    monthBlocks.forEach((el) => {
      el.classList.toggle('hidden', Number(el.dataset.i) !== active);
    });
  };
  section
    .querySelectorAll<HTMLButtonElement>('.cal-prev')
    .forEach((b) => b.addEventListener('click', () => showMonth(active - 1)));
  section
    .querySelectorAll<HTMLButtonElement>('.cal-next')
    .forEach((b) => b.addEventListener('click', () => showMonth(active + 1)));

  // ---- Detalhe da noite ----
  type Service = {
    name: string;
    type: string;
    price: string;
    desc: string;
    available: boolean;
    href: string;
    dateKey: string;
    slotTime?: string;
  };
  type NightEvent = { title: string; typeLabel: string; price: string; href: string };
  type Night = {
    day: number;
    dateKey: string;
    weekday: string;
    dateLabel: string;
    illum: number;
    waxing: boolean;
    tone: 'dark' | 'good' | 'bright';
    verdict: string;
    phase: string | null;
    phaseTime: string | null;
    services: Service[];
    events: NightEvent[];
  };
  type MonthData = {
    monthLabel: string;
    milkyWay: boolean;
    nights: Record<string, Night>;
  };
  type Data = {
    stargazingLinks: Record<'1' | '2' | '3' | '4', string>;
    stargazingPricePerAdult: number;
    months: MonthData[];
  };

  const data: Data = JSON.parse(
    document.getElementById('calendar-data')!.textContent!
  );

  const modal = document.getElementById('night-modal')!;
  const $ = (id: string) => document.getElementById(id)!;

  const discSvg = (illum: number, waxing: boolean) => {
    const ring =
      '<circle cx="8" cy="8" r="7" fill="#121212" stroke="currentColor" stroke-width="1"/>';
    if (illum <= 3) return `<svg viewBox="0 0 16 16" width="100%" height="100%">${ring}</svg>`;
    if (illum >= 97)
      return '<svg viewBox="0 0 16 16" width="100%" height="100%"><circle cx="8" cy="8" r="7" fill="currentColor"/></svg>';
    const half = waxing
      ? '<path d="M8 1 A7 7 0 0 1 8 15 Z" fill="currentColor"/>'
      : '<path d="M8 1 A7 7 0 0 0 8 15 Z" fill="currentColor"/>';
    return `<svg viewBox="0 0 16 16" width="100%" height="100%">${ring}${half}</svg>`;
  };

  const openNight = (mi: number, day: number) => {
    const mv = data.months[mi];
    const n = mv?.nights[String(day)];
    if (!n) return;

    $('nm-weekday').textContent = n.weekday;
    $('nm-title').textContent = n.dateLabel;
    $('nm-moon').innerHTML = discSvg(n.illum, n.waxing);
    $('nm-verdict').textContent = n.verdict;

    const phaseTxt = n.phase ? `${n.phase} (${n.phaseTime}) · ` : '';
    $('nm-moontext').textContent = `${phaseTxt}Lua ${n.illum}% iluminada`;

    // Céu desta noite
    const sky: string[] = [];
    if (mv.milkyWay && n.tone === 'dark')
      sky.push('Núcleo da Via Láctea bem visível');
    const skyEl = $('nm-sky');
    skyEl.innerHTML = sky.map((s) => `<li>${s}</li>`).join('');
    skyEl.classList.toggle('hidden', sky.length === 0);

    // CTA de reserva por atividade: eventos do Luma (1 botão, link real do
    // evento) vs. serviços do Cal.com (badge disponível/esgotado + "Reservar
    // agora" + "Saber mais", este último ainda placeholder/inativo).
    const escAttr = (s: string) => s.replace(/"/g, '&quot;');

    const eventCard = (e: NightEvent) => `
      <div class="flex items-center justify-between gap-3 rounded-xl border border-cream-50/12 bg-night-950/50 px-4 py-3">
        <div class="min-w-0">
          <div class="flex items-baseline gap-2">
            <p class="font-medium">${e.title}</p>
            <span class="shrink-0 text-sm font-bold">${e.price}</span>
          </div>
          <span class="mt-1 inline-block rounded-full border border-cream-50/15 px-2 py-0.5 text-[0.65rem] text-cream-50/55">${e.typeLabel}</span>
        </div>
        <a href="${escAttr(e.href)}" target="_blank" rel="noopener" class="btn btn-primary !min-h-0 shrink-0 !px-4 !py-2 text-xs">Reservar</a>
      </div>`;

    const serviceCard = (s: Service) => {
      const cta = !s.available
        ? `<span class="btn !min-h-0 flex-1 cursor-not-allowed !px-4 !py-2 text-xs opacity-40">Reservar agora</span>`
        : s.type === 'stargazing'
          ? `<button type="button" data-open-stargazing data-date="${escAttr(s.dateKey)}" data-slot="${escAttr(s.slotTime ?? '')}" class="btn btn-primary !min-h-0 flex-1 !px-4 !py-2 text-xs">Reservar agora</button>`
          : `<button type="button" data-book-link="${escAttr(new URL(s.href).pathname.replace(/^\/+/, ''))}" data-book-date="${escAttr(s.dateKey)}" data-book-month="${escAttr(s.dateKey.slice(0, 7))}" data-book-slot="${escAttr(s.slotTime ?? '')}" class="btn btn-primary !min-h-0 flex-1 !px-4 !py-2 text-xs">Reservar agora</button>`;
      return `
      <div class="rounded-xl border border-cream-50/12 bg-night-950/50 px-4 py-3">
        <div class="flex items-baseline gap-2">
          <p class="font-medium">${s.name}</p>
          <span class="shrink-0 text-sm font-bold">${s.price}</span>
        </div>
        ${s.desc ? `<p class="mt-1 text-xs text-cream-50/55">${s.desc}</p>` : ''}
        <span class="mt-1.5 inline-flex items-center gap-1.5 text-[0.7rem] font-medium ${s.available ? 'text-accent-200' : 'text-cream-50/45'}">
          <span class="h-1.5 w-1.5 rounded-full ${s.available ? 'bg-accent-300' : 'bg-cream-50/30'}"></span>
          ${s.available ? 'Disponível' : 'Sem vagas nos próximos 30 dias'}
        </span>
        <div class="mt-3 flex items-center gap-2">
          ${cta}
          ${
            s.type === 'stargazing'
              ? `<a href="/observacao-noturna" class="btn btn-ghost !min-h-0 flex-1 !px-4 !py-2 text-xs">Saber mais</a>`
              : s.type === 'retratos'
                ? `<a href="/retratos" class="btn btn-ghost !min-h-0 flex-1 !px-4 !py-2 text-xs">Saber mais</a>`
                : `<span class="btn btn-ghost !min-h-0 flex-1 cursor-not-allowed !px-4 !py-2 text-xs opacity-40" title="Brevemente">Saber mais</span>`
          }
        </div>
      </div>`;
    };

    const cards: string[] = [
      ...n.events.map(eventCard),
      ...n.services.map(serviceCard),
    ];
    $('nm-activities').innerHTML = cards.join('');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  const bindOpen = (el: HTMLElement) =>
    el.addEventListener('click', () =>
      openNight(Number(el.dataset.i), Number(el.dataset.day))
    );
  section.querySelectorAll<HTMLElement>('.day-cell').forEach(bindOpen);
  modal.querySelector('.modal-close')!.addEventListener('click', closeModal);
  modal.querySelector('.modal-backdrop')!.addEventListener('click', closeModal);

  // ---- Previsão meteorológica (nebulosidade) ----
  // Open-Meteo: sem chave, sem limite relevante para este uso, até 16 dias.
  // Pedido no browser (não no build) porque o tempo muda muito mais depressa
  // do que a disponibilidade do site é publicada de novo. Mesmas coordenadas
  // do observatório usadas no widget de seeing (Meteoblue.astro).
  const WEATHER_URL =
    'https://api.open-meteo.com/v1/forecast?latitude=38.742&longitude=-8.077&hourly=cloud_cover&timezone=Europe%2FLisbon&forecast_days=16';

  // Mesmo ícone da legenda (cloudSvg no frontmatter) -- duplicado aqui porque
  // o frontmatter corre no build e este <script> corre à parte, no browser.
  const CLOUD_SVG =
    '<svg viewBox="0 0 16 16" width="100%" height="100%" aria-hidden="true"><path d="M4.5 12.5a2.5 2.5 0 0 1-.3-4.98 3 3 0 0 1 5.6-1.7A2.6 2.6 0 0 1 13 8.4a2.1 2.1 0 0 1-.1 4.1H4.5Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  // Agrupa as horas de cada previsão pela "noite" a que pertencem: janela
  // 20h-00h do próprio dia (não atravessa a meia-noite, não precisa de
  // aritmética de datas).
  async function loadNightlyCloudCover(): Promise<Map<string, number>> {
    try {
      const res = await fetch(WEATHER_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const times: string[] = json.hourly.time;
      const clouds: number[] = json.hourly.cloud_cover;

      const byNight = new Map<string, number[]>();
      for (let i = 0; i < times.length; i++) {
        const date = times[i].slice(0, 10);
        const hour = Number(times[i].slice(11, 13));
        if (hour < 20) continue;
        (byNight.get(date) ?? byNight.set(date, []).get(date)!).push(clouds[i]);
      }

      const avgByNight = new Map<string, number>();
      byNight.forEach((vals, key) => {
        avgByNight.set(key, Math.round(vals.reduce((a, b) => a + b, 0) / vals.length));
      });
      return avgByNight;
    } catch (err) {
      console.warn('[weather] falha ao obter previsão da Open-Meteo:', err);
      return new Map();
    }
  }

  loadNightlyCloudCover().then((avgByNight) => {
    if (avgByNight.size === 0) return;
    section.querySelectorAll<HTMLButtonElement>('.day-cell[data-day]').forEach((cell) => {
      // Ignora noites já passadas -- não faz sentido mostrar previsão numa
      // célula que já nem é clicável.
      if (cell.disabled) return;

      const mi = Number(cell.dataset.i);
      const day = Number(cell.dataset.day);
      const n = data.months[mi]?.nights[String(day)];
      const badge = cell.querySelector<HTMLElement>('[data-weather-badge]');
      const icon = badge?.querySelector<HTMLElement>('[data-weather-icon]');
      const text = badge?.querySelector<HTMLElement>('[data-weather-text]');
      if (!n || !badge || !icon || !text) return;

      const cloud = avgByNight.get(n.dateKey);
      if (cloud == null) return;

      icon.innerHTML = CLOUD_SVG;
      text.textContent = `${cloud}%`;
      badge.title = `${cloud}% de nebulosidade prevista para esta noite (Open-Meteo)`;
      // "flex" só entra depois de tirar "hidden" -- os dois em simultâneo
      // dependem da ordem das regras geradas pelo Tailwind, é frágil.
      badge.classList.remove('hidden');
      badge.classList.add('flex');
    });
  });

  // ---- Popup de quantidade — Stargazing ----
  // Só adultos pagam; cada quantidade (1-4) é um event type próprio no
  // Cal.com com o seu preço, e reservar qualquer um bloqueia os outros 3
  // nessa noite (partilham o mesmo calendário). Este popup só escolhe qual
  // dos 4 links abrir -- a pergunta sobre crianças fica no próprio Cal.com.
  const sgModal = $('stargazing-modal');
  const sgOptionsEl = $('sg-options');
  const sgContinue = $('sg-continue') as HTMLButtonElement;
  const sgDateEl = $('sg-date');
  let sgSelected = 1;

  const renderStargazingOptions = () => {
    sgOptionsEl.innerHTML = ([1, 2, 3, 4] as const)
      .map((n) => {
        const price = n * data.stargazingPricePerAdult;
        const active = n === sgSelected;
        return `
          <button
            type="button"
            data-adults="${n}"
            class="flex w-full items-center justify-between rounded-xl border px-4 py-3 text-left transition-colors ${
              active
                ? 'border-accent-300 bg-accent-400/10'
                : 'border-cream-50/15 hover:border-cream-50/30'
            }"
          >
            <span class="font-medium">${n} adulto${n > 1 ? 's' : ''}</span>
            <span class="font-bold">${price}€</span>
          </button>`;
      })
      .join('');
    sgOptionsEl.querySelectorAll<HTMLButtonElement>('button[data-adults]').forEach((b) =>
      b.addEventListener('click', () => {
        sgSelected = Number(b.dataset.adults);
        renderStargazingOptions();
      })
    );
  };

  const openStargazingModal = (dateKey?: string, slotTime?: string) => {
    // Nunca deixar o modal de detalhe do dia aberto por baixo -- garante
    // que o popup tem sempre o mesmo aspeto, venha de onde vier.
    closeModal();
    sgSelected = 1;
    if (dateKey) {
      sgModal.dataset.date = dateKey;
      sgDateEl.textContent = 'Para esta noite';
      sgDateEl.classList.remove('hidden');
    } else {
      delete sgModal.dataset.date;
      sgDateEl.classList.add('hidden');
    }
    if (slotTime) {
      sgModal.dataset.slot = slotTime;
    } else {
      delete sgModal.dataset.slot;
    }
    renderStargazingOptions();
    sgModal.classList.remove('hidden');
    sgModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeStargazingModal = () => {
    sgModal.classList.add('hidden');
    sgModal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  sgContinue.addEventListener('click', () => {
    const base = data.stargazingLinks[String(sgSelected) as '1' | '2' | '3' | '4'];
    const date = sgModal.dataset.date;
    const slot = sgModal.dataset.slot;
    closeStargazingModal();
    // Com hora de horário conhecida (`slot`), o embed salta o calendário do
    // Cal.com e abre já no formulário de dados -- ver bookingHref() no
    // frontmatter para a explicação de como isto funciona no lado do
    // Cal.com. As 4 variantes de nº de adultos partilham o mesmo calendário
    // (ver STARGAZING_LINKS em calcom.ts), por isso a hora consultada na
    // variante de 1 adulto vale para todas.
    (window as any).openCalModal(base, {
      date: date || undefined,
      month: date ? date.slice(0, 7) : undefined,
      slot: slot || undefined,
    });
  });

  // Delegado no document (não só na section): apanha os botões estáticos
  // (card "sempre", CTA da secção Pillar mais acima na página) e os
  // injetados dinamicamente dentro do modal de detalhe da noite -- o
  // popup tem de abrir sempre igual, venha o clique de onde vier.
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open-stargazing]');
    if (!trigger) return;
    openStargazingModal(trigger.dataset.date || undefined, trigger.dataset.slot || undefined);
  });
  sgModal.querySelector('.modal-close')!.addEventListener('click', closeStargazingModal);
  sgModal.querySelector('.modal-backdrop')!.addEventListener('click', closeStargazingModal);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!modal.classList.contains('hidden')) closeModal();
    if (!sgModal.classList.contains('hidden')) closeStargazingModal();
  });
</script>
